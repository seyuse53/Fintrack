<Window x:Class="FinTrack.WPF.MakePaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kredi Kartı Ödemesi" Height="280" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" Text="Kredi kartı ödemenizi girin:" 
                   FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="Ödeme Yapılan Hesap:" Margin="0,0,0,5" Foreground="#555"/>
        <ComboBox x:Name="SourceCombo" Grid.Row="2" Margin="0,0,0,10" Padding="4" FontSize="14" Height="30" VerticalContentAlignment="Center" Background="White"/>

        <TextBlock Grid.Row="3" Text="Tutar (₺):" Margin="0,0,0,5" Foreground="#555"/>
        <TextBox x:Name="AmountBox" Grid.Row="4" Padding="6" FontSize="16" 
                 VerticalContentAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="İptal" Width="70" Padding="6" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Öde" Width="70" Padding="6" Background="#4CAF50" Foreground="White" 
                    BorderThickness="0" Click="Pay_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
