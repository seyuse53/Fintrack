<Window x:Class="FinTrack.WPF.GeneralConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay Gerekli" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Viewbox Width="28" Height="28">
                    <Path x:Name="IconPath" Data="M11,15H13V17H11V15M11,7H13V13H11V7M12,2C6.47,2 2,6.5 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Fill="#F39C12"/>
                </Viewbox>
                <TextBlock x:Name="TitleText" Text="Dikkat" FontSize="17" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="İşlemi onaylıyor musunuz?" 
                       FontSize="14" Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Vazgeç" Width="90" Height="32" Margin="0,0,10,0" 
                        Click="Cancel_Click" Background="Transparent" BorderBrush="#DDD" Foreground="#666">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button x:Name="ConfirmButton" Content="Evet, Onayla" Width="120" Height="32" 
                        Click="Confirm_Click" Background="#007ACC" Foreground="White" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
