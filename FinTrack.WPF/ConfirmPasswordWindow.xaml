<Window x:Class="FinTrack.WPF.ConfirmPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlemi Onayla" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Border Margin="15" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel Margin="15">
            <TextBlock Text="Güvenlik Doğrulaması" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,10"/>
            <TextBlock Text="Devam etmek için lütfen şifrenizi girin:" Foreground="#666" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <PasswordBox x:Name="PasswordInput" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click" Background="Transparent" BorderBrush="#CCC"/>
                <Button Content="Onayla" Width="100" Height="30" Click="Confirm_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
