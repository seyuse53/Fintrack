<UserControl x:Class="FinTrack.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Custom ProgressBar Style for Bar Charts -->
        <Style x:Key="CategoryProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="#3498DB"/>
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="6" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filtre Çubuğu -->
            <RowDefinition Height="Auto"/> <!-- Özet Kartları -->
            <RowDefinition Height="*"/>    <!-- İçerik Sekmeleri -->
        </Grid.RowDefinitions>

        <!-- Filtre Çubuğu -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Başlangıç Tarihi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,10,0"/>
                <DatePicker x:Name="StartDatePicker" Width="130" Margin="0,0,20,0"/>
                
                <TextBlock Text="Bitiş Tarihi:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,10,0"/>
                <DatePicker x:Name="EndDatePicker" Width="130" Margin="0,0,20,0"/>

                <Button Content="🔍 Analiz Et" x:Name="FetchButton" Click="FetchButton_Click" 
                        Padding="20,8" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <!-- Özet Kartları -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Dönem Geliri" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="IncomeCardText" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Dönem Gideri" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ExpenseCardText" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Net Tasarruf" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="BalanceCardText" Text="₺0,00" FontSize="20" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- İçerik Sekmeleri -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="HeaderTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="15" FontWeight="Bold" Margin="10,5"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </TabControl.Resources>

            <!-- 1. HARCAMA ANALİZİ -->
            <TabItem Header="📊 Harcama Dağılımı">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bar Chart Area -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="En Çok Harcanan Kategoriler" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
                            <ItemsControl x:Name="TopCategoriesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,15">
                                            <Grid>
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="#34495E"/>
                                                <TextBlock Text="{Binding FormattedAmount}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2C3E50"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Percentage}" Style="{StaticResource CategoryProgressBar}" Margin="0,5,0,2" Foreground="{Binding Color}"/>
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Full Breakdown Grid -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Tüm Giderlerin Dökümü" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                            <DataGrid x:Name="FullBreakdownGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="*"/>
                                    <DataGridTextColumn Header="İşlem Sayısı" Binding="{Binding Count}" Width="100"/>
                                    <DataGridTextColumn Header="Toplam Tutar" Binding="{Binding TotalAmount, StringFormat='₺{0:N2}'}" Width="150" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Pay" Binding="{Binding Percentage, StringFormat='{}{0:F1}%'}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2. TREND ANALİZİ -->
            <TabItem Header="📈 Trendler (6 Ay)">
                <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="30" Margin="0,15,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Aylık Gelir vs Gider Karşılaştırması" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,30"/>
                        
                        <!-- Simple Manual Charting with ItemsControl -->
                        <ItemsControl Grid.Row="1" x:Name="MonthlyTrendsList" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="15,0" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Height="250">
                                            <!-- Income Bar -->
                                            <Border Width="25" Background="#27AE60" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                    Height="{Binding IncomeHeight}" ToolTip="{Binding IncomeAmount, StringFormat='Gelir: ₺{0:N2}'}"/>
                                            <Border Width="5"/>
                                            <!-- Expense Bar -->
                                            <Border Width="25" Background="#E74C3C" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                    Height="{Binding ExpenseHeight}" ToolTip="{Binding ExpenseAmount, StringFormat='Gider: ₺{0:N2}'}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MonthLabel}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </TabItem>

            <!-- 3. YATIRIM ANALİZİ -->
            <TabItem Header="💎 Yatırım Dağılımı">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20" Margin="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="Portföy Dağılımı (Varlık Türü)" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
                            <ItemsControl x:Name="InvestmentAllocationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,15">
                                            <Grid>
                                                <TextBlock Text="{Binding AssetCategory}" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="#34495E"/>
                                                <TextBlock Text="{Binding FormattedValue}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#2C3E50"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding Percentage}" Style="{StaticResource CategoryProgressBar}" Foreground="#F1C40F" Margin="0,5,0,2"/>
                                            <TextBlock Text="{Binding Percentage, StringFormat='{}{0:F1}%'}" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="#2980B9" CornerRadius="12" Padding="25" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="TOPLAM PORTFÖY DEĞERİ" Foreground="White" FontSize="14" Opacity="0.8" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TotalPortfolioValueText" Text="₺0,00" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="25" Margin="0,10,0,0">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="TOPLAM KÂR / ZARAR" Foreground="#7F8C8D" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TotalInvestmentProfitText" Text="₺0,00" Foreground="#27AE60" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
