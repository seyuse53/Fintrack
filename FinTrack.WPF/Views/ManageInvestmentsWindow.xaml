<Window x:Class="FinTrack.WPF.Views.ManageInvestmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yatırımları Yönet" Height="500" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Yatırım Portföyü Yönetimi" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                <TextBlock Text="Mevcut varlıklarınızı listeleyebilir, yeni alım satım işlemi yapabilirsiniz." FontSize="12" Foreground="#7F8C8D" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Yeni Yatırım (Satın Al)" Padding="15,8" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="AddInvestment_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Investments Grid -->
        <DataGrid x:Name="InvestmentsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="White" RowBackground="White"
                  AlternatingRowBackground="#F8F9F9" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sembol" Binding="{Binding Symbol}" Width="80" FontWeight="Bold"/>
                <DataGridTextColumn Header="Varlık Adı" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Miktar" Binding="{Binding TotalAmount, StringFormat=N2}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ortalama Maliyet" Binding="{Binding AverageCost, StringFormat='₺{0:N2}'}" Width="120">
                     <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="İşlemler" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📋 Geçmiş" Tag="{Binding Id}" Click="ViewHistory_Click"
                                        Padding="8,4" Margin="0,0,5,0" Background="#3498DB" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="✏️ Düzenle" Tag="{Binding Id}" Click="EditInvestment_Click"
                                        Padding="8,4" Margin="0,0,5,0" Background="#8E44AD" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="💸 Sat" Tag="{Binding Id}" Click="SellInvestment_Click"
                                        Padding="8,4" Margin="0,0,5,0" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="🗑️ Sil" Tag="{Binding Id}" Click="DeleteInvestment_Click"
                                        Padding="8,4" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kapat" Width="100" Padding="10" Click="Close_Click" Background="#BDC3C7" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
