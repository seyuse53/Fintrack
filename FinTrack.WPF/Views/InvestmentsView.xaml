<UserControl x:Class="FinTrack.WPF.Views.InvestmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:FinTrack.WPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Loaded="UserControl_Loaded">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and Buttons -->
            <RowDefinition Height="Auto"/> <!-- Portfolio Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Assets Grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="📈 Yatırım Portföyü" FontSize="26" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>

            <!-- Kategori Filtresi -->
            <ComboBox x:Name="CategoryFilterComboBox" Grid.Column="2" Width="160" Padding="10,6" FontSize="13"
                      VerticalAlignment="Center" SelectionChanged="CategoryFilter_SelectionChanged">
                <ComboBoxItem Content="Tümü" IsSelected="True"/>
                <ComboBoxItem Content="Altın"/>
                <ComboBoxItem Content="Döviz"/>
                <ComboBoxItem Content="Hisse Senedi"/>
                <ComboBoxItem Content="Kripto Para"/>
                <ComboBoxItem Content="Fon"/>
                <ComboBoxItem Content="Diğer"/>
            </ComboBox>

            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TaxReportButton" Content="📊 Vergi Raporu" Width="Auto"
                        Padding="15,8" Margin="0,0,10,0" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="TaxReportButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="FetchApiPricesButton" Content="🌐 Fiyatları Çek (API)" Width="Auto"
                        Padding="15,8" Margin="0,0,10,0" Background="#9B59B6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="FetchApiPricesButton_Click" Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="UpdatePricesButton" Content="✍️ Fiyat Güncelle" Width="Auto"
                        Padding="15,8" Margin="0,0,10,0" Background="#F1C40F" Foreground="#2C3E50" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="UpdatePricesButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ManageInvestmentsButton" Content="⚙️ Veri Girişi / Yönet" Width="Auto"
                        Padding="15,8" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="ManageInvestmentsButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Portfolio Summary Cards (4 kart) -->
        <Grid Grid.Row="1" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toplam Portföy Değeri -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Toplam Portföy Değeri" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalPortfolioValueText" Text="₺0.00" FontSize="24" FontWeight="Bold" Foreground="#2980B9" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Toplam Maliyet -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Toplam Maliyet" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalCostBasisText" Text="₺0.00" FontSize="24" FontWeight="Bold" Foreground="#34495E" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Net Kar / Zarar -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Net Kar / Zarar" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock x:Name="TotalProfitText" Text="₺0.00" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="TotalProfitPercentageText" Text="(%0.0)" FontSize="15" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Bottom" Margin="5,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- En Kârlı Varlık -->
            <Border Grid.Column="6" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="🏆 En Kârlı Varlık" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TopPerformerNameText" Text="—" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TopPerformerProfitText" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dynamic List of Investment Assets (Tıklanabilir Kartlar) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="InvestmentsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="350" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,20,20" Padding="20"
                                Cursor="Hand" MouseLeftButtonUp="AssetCard_Click" Tag="{Binding Id}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#3498DB"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/> 
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/> 
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Grid.Row="1" Text="{Binding Symbol}" FontSize="13" Foreground="#95A5A6" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="0" Grid.RowSpan="2" Text="{Binding Category}" FontSize="12" Foreground="#8E44AD" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" Background="#F4ECF7" Padding="8,4" />

                                <!-- Amounts -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Miktar" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding AmountText}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Mevcut Fiyat (Birim)" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding CurrentPrice, StringFormat='₺{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#2980B9"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Mevcut Değer ve Portföy Ağırlığı -->
                                <Grid Grid.Row="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Mevcut Değer" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding CurrentValue, StringFormat='₺{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="#2980B9"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="Portföy Ağırlığı" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding PortfolioWeight}" FontSize="16" FontWeight="Bold" Foreground="#8E44AD" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Mini Sparkline -->
                                <controls:SparklineControl Grid.Row="7" 
                                    Data="{Binding SparklineData}"
                                    ShowFill="False" ShowLabels="False" ShowTooltip="False"
                                    Height="35" Margin="0,0,0,0"/>

                                <!-- Value & Profit Footer -->
                                <Grid Grid.Row="9" Background="#F8F9F9" Margin="-20,0,-20,-20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="20">
                                        <TextBlock Text="Ort. Maliyet" FontSize="12" Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding AverageCost, StringFormat='₺{0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="20" HorizontalAlignment="Right">
                                        <TextBlock Text="Kar/Zarar" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding ProfitText}" FontSize="16" FontWeight="Bold" Foreground="{Binding ProfitColor}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
