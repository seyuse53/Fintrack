<Window x:Class="FinTrack.WPF.Views.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinTrack - Kilitli" Height="1000" Width="1000"
        WindowStyle="None" WindowState="Maximized" Topmost="True" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#E62C3E50" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2980B9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDC3C7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D5DBDB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Center content box -->
        <Border Background="White" Width="380" CornerRadius="12" Padding="40" 
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel>
                <!-- Lock Icon / Title -->
                <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Oturum Kilitlendi" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Güvenliğiniz için uygulama otomatik olarak kilitlendi. Devam etmek için şifrenizi girin." 
                           TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,25"/>

                <!-- Error Message -->
                <TextBlock x:Name="ErrorText" Text="Hatalı şifre girdiniz." Foreground="#E74C3C" 
                           Visibility="Collapsed" FontSize="13" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <!-- Password Input -->
                <TextBlock Text="Uygulama Şifreniz:" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordInput" Margin="0,0,0,20" KeyDown="PasswordInput_KeyDown"/>

                <!-- Buttons -->
                <Button Content="Kilidi Aç" Style="{StaticResource RoundedButton}" Click="Unlock_Click" Margin="0,0,0,10"/>
                <Button Content="Uygulamadan Çık" Background="Transparent" Foreground="#E74C3C" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Exit_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
