                                    <TextBlock Style="{StaticResource ExpanderContent}" FontWeight="Bold" Foreground="#34495E" Text="Akıllı Arama (Global Search):"/>
                                    <TextBlock Style="{StaticResource ExpanderContent}" Margin="5,0,5,10" Text="Aylık işlem listesinde arama çubuğunu kullanarak tarih, açıklama veya tutara göre anlık filtreleme yapabilirsiniz. 'Market', 'Yemek' gibi kelimelerle arama yaparak geçmiş harcamalarınızı saniyeler içinde bulabilirsiniz."/>

                                    <TextBlock Style="{StaticResource ExpanderContent}" FontWeight="Bold" Foreground="#34495E" Text="Ödeme Yöntemi:"/>
                                    <TextBlock Style="{StaticResource ExpanderContent}" Margin="5,0,5,5" Text="Sabit bir Gelir (örn: Maaş, EFT) eklerken 'Ödeme Yöntemi' seçeneğinden hedeflenen Banka Hesabını seçerek paranın doğrudan banka cüzdanınıza girmesini sağlayabilirsiniz."/>
                                </StackPanel>
