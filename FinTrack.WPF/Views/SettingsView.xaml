<UserControl x:Class="FinTrack.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Loaded="UserControl_Loaded"
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ContextMenu x:Key="CategoryContextMenu">
            <MenuItem Header="✏️ Düzenle" Click="CategoryEdit_Click"/>
        </ContextMenu>
    </UserControl.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚙️ Ayarlar" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Padding="20,10" Margin="0,0,10,0" Background="#ECF0F1" CornerRadius="5,5,0,0">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#7F8C8D"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="White"/>
                                        <Setter Property="Panel.ZIndex" Value="100"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: GÜVENLİK -->
            <TabItem Header="🔒 Güvenlik">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" Padding="30" CornerRadius="0,8,8,8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1">
                        <StackPanel>
                            <!-- Giriş Şifresini Değiştir Kartı -->
                            <Border Background="White" CornerRadius="12" BorderBrush="#EBEDEF" BorderThickness="1" Margin="0,0,0,30" Padding="25">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Giriş Şifresini Değiştir" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Uygulama girişinde kullandığınız ve verilerinizi şifreleyen ana şifreyi buradan güncelleyebilirsiniz." 
                                               FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,25" TextWrapping="Wrap"/>

                                    <Grid Width="500" HorizontalAlignment="Left" Margin="0,15,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Mevcut Şifre -->
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mevcut Şifre" VerticalAlignment="Center" Foreground="#34495E" FontWeight="SemiBold"/>
                                        <PasswordBox x:Name="CurrentPasswordBox" Grid.Row="0" Grid.Column="1" Padding="10" Margin="0,0,0,15" BorderBrush="#D5DBDB" Background="#FDFEFE"/>

                                        <!-- Yeni Şifre -->
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Yeni Şifre" VerticalAlignment="Center" Foreground="#34495E" FontWeight="SemiBold"/>
                                        <PasswordBox x:Name="NewPasswordBox" Grid.Row="1" Grid.Column="1" Padding="10" Margin="0,0,0,15" BorderBrush="#D5DBDB" Background="#FDFEFE"/>

                                        <!-- Yeni Şifre (Tekrar) -->
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Yeni Şifre (Tekrar)" VerticalAlignment="Center" Foreground="#34495E" FontWeight="SemiBold"/>
                                        <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="2" Grid.Column="1" Padding="10" Margin="0,0,0,5" BorderBrush="#D5DBDB" Background="#FDFEFE"/>

                                        <TextBlock x:Name="PasswordStatusText" Grid.Row="3" Grid.Column="1" Text="" Foreground="#E74C3C" FontSize="12" Margin="0,0,0,20"/>
                                    </Grid>

                                    <Button Content="Şifreyi Şimdi Güncelle" HorizontalAlignment="Right" Padding="30,12" 
                                            Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0"
                                            Click="ChangePassword_Click" Cursor="Hand" MaxWidth="250">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Otomatik Kilitleme (Auto-Lock) Bölümü -->
                            <StackPanel Margin="0,30,0,0">
                                <TextBlock Text="Otomatik Kilitleme (Auto-Lock)" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                                <TextBlock Text="Hareketsizlik durumunda ekrana şifre kalkanı koyarak verilerinizi meraklı gözlerden koruyun." 
                                           FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                
                                <Border Background="#F8F9F9" Padding="20" CornerRadius="8" BorderBrush="#D5DBDB" BorderThickness="1">
                                    <StackPanel>
                                        <CheckBox x:Name="EnableAutoLockCheckBox" Content="Hareketsizlik durumunda uygulamayı kilitle" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                                        
                                        <StackPanel x:Name="AutoLockSettingsPanel">
                                            <TextBlock Text="Kilitlenme Süresi (Dakika):" FontSize="12" Foreground="#34495E" Margin="0,0,0,5"/>
                                            <TextBox x:Name="AutoLockTimeoutTextBox" Text="3" Padding="8" Background="White" BorderBrush="#D5DBDB" FontSize="13" Width="100" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Margin="0,0,0,15"/>
                                        </StackPanel>

                                        <Button x:Name="SaveAutoLockSettingsButton" Content="⏱️ Kilitleme Ayarlarını Kaydet" Width="Auto" HorizontalAlignment="Left"
                                                Padding="15,8" Margin="0,0,0,0" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                                Click="SaveAutoLockSettingsButton_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: KATEGORİ YÖNETİMİ -->
            <TabItem Header="🏷️ Kategoriler">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" Padding="30" CornerRadius="0,8,8,8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1">
                        <StackPanel>
                            <TextBlock Text="Kategori Yönetimi" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBlock Text="İşlem listesinde görmek istemediğiniz kategorileri sağ tarafa (gizli) taşıyabilirsiniz. Bu işlem geçmiş verilerinizi silmez." 
                                       FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,25" TextWrapping="Wrap"/>

                            <!-- Yeni Kategori Ekleme Paneli -->
                            <Border Background="#F9FAF9" Padding="20" CornerRadius="8" BorderBrush="#D5DBDB" BorderThickness="1" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Yeni Kategori Ekle" FontSize="14" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Row 0: Labels -->
                                        <TextBlock Text="Kategori Adı" Grid.Row="0" Grid.Column="0" Foreground="#7F8C8D" FontSize="11" Margin="5,0,0,2"/>
                                        <TextBlock Text="Tür" Grid.Row="0" Grid.Column="1" Foreground="#7F8C8D" FontSize="11" Margin="5,0,0,2"/>
                                        <TextBlock Text="Üst Kategori (İsteğe Bağlı)" Grid.Row="0" Grid.Column="2" Foreground="#7F8C8D" FontSize="11" Margin="5,0,0,2"/>

                                        <!-- Row 1: Inputs -->
                                        <TextBox x:Name="NewCategoryNameTextBox" Grid.Row="1" Grid.Column="0" Padding="10" Margin="0,0,10,0" 
                                                 BorderBrush="#D5DBDB" FontSize="13" Foreground="#34495E"/>

                                        <ComboBox x:Name="NewCategoryTypeComboBox" Grid.Row="1" Grid.Column="1" Padding="10" Margin="0,0,10,0" FontSize="13" SelectionChanged="NewCategoryTypeComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Gider (Expense)" IsSelected="True"/>
                                            <ComboBoxItem Content="Gelir (Income)"/>
                                        </ComboBox>

                                        <ComboBox x:Name="ParentCategoryComboBox" Grid.Row="1" Grid.Column="2" Padding="10" Margin="0,0,10,0" FontSize="13" DisplayMemberPath="FullDisplayName">
                                        </ComboBox>

                                        <Button Grid.Row="1" Grid.Column="3" Content="➕ Ekle" Padding="20,10" Background="#3498DB" Foreground="White" 
                                                FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="AddNewCategory_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Çift Listeli Görünüm (Dual-Pane) -->
                            <Grid Height="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sol: Görünür Kategoriler -->
                                <Border Grid.Column="0" Background="#FDFEFE" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#27AE60" CornerRadius="5,5,0,0" Padding="10">
                                            <TextBlock Text="✅ Görünür (Aktif) Kategoriler" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ListBox x:Name="VisibleCategoriesListBox" Grid.Row="1" Margin="5" BorderThickness="0" FontSize="14" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,2,0,2">
                                                        <!-- İndentasyon (Alt Kategori ise sola boşluk) -->
                                                        <Border x:Name="IndentSpace" Width="0"/>
                                                        
                                                        <!-- Tip İkonu ve Renk Çubuğu -->
                                                        <Border x:Name="TypeMarker" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding TypeIcon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                                                        
                                                        <!-- Kategori Adı -->
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                                                            <Setter Property="Foreground" Value="#5D6D7E"/>
                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                                            <Setter TargetName="IndentSpace" Property="Width" Value="25"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#27AE60"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Transfer">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#3498DB"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="ToolTip" Value="{Binding FullDisplayName}"/>
                                                    <Setter Property="Padding" Value="5"/>
                                                    <Setter Property="ContextMenu" Value="{StaticResource CategoryContextMenu}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>

                                <!-- Orta: Transfer Butonları -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Content="Gizle ➡️" Width="60" Height="40" Margin="0,0,0,15" Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                                            BorderThickness="0" Cursor="Hand" Click="HideCategory_Click" ToolTip="Seçili kategorileri gizle">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="⬅️ Göster" Width="60" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" 
                                            BorderThickness="0" Cursor="Hand" Click="ShowCategory_Click" ToolTip="Seçili kategorileri tekrar görünür yap">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>

                                <!-- Sağ: Gizli Kategoriler -->
                                <Border Grid.Column="2" Background="#FDFEFE" BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Background="#95A5A6" CornerRadius="5,5,0,0" Padding="10">
                                            <TextBlock Text="👁️‍🗨️ Gizli Kategoriler" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ListBox x:Name="HiddenCategoriesListBox" Grid.Row="1" Margin="5" BorderThickness="0" FontSize="14" Foreground="#7F8C8D" SelectionMode="Multiple">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="2,2,0,2">
                                                        <Border x:Name="IndentSpace" Width="0"/>
                                                        <Border x:Name="TypeMarker" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding TypeIcon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#7F8C8D">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                                                            <Setter Property="FontStyle" Value="Italic"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                                            <Setter TargetName="IndentSpace" Property="Width" Value="25"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#27AE60"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#E74C3C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Transfer">
                                                            <Setter TargetName="TypeMarker" Property="Background" Value="#3498DB"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="ToolTip" Value="{Binding FullDisplayName}"/>
                                                    <Setter Property="Padding" Value="5"/>
                                                    <Setter Property="ContextMenu" Value="{StaticResource CategoryContextMenu}"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: BULUT SENKRONİZASYONU & YEDEKLEME -->
            <TabItem Header="☁️ Bulut ve Yedekleme">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" Padding="30" CornerRadius="0,8,8,8" BorderBrush="#E0E0E0" BorderThickness="0,1,1,1">
                        <StackPanel>
                            <TextBlock Text="Bulut Senkronizasyonu ve Yedekleme" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,5"/>
                            <TextBlock Text="Veritabanınızı doğrudan buluta taşıyın veya otomatik yedekleme kurallarını belirleyin." 
                                       FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,25"/>

                            <Border Background="#F8F9F9" Padding="20" CornerRadius="8" BorderBrush="#D5DBDB" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Mevcut Veritabanı Konumu" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathTextBox" IsReadOnly="True" Padding="10" Background="White" BorderBrush="#D5DBDB" 
                                                 FontSize="12" Foreground="#34495E"/>
                                        <Button Grid.Column="1" Content="Klasör Seç" Padding="20,8" Margin="10,0,0,0" 
                                                Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                                Click="SelectFolder_Click" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="5"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                    
                                    <Button x:Name="SaveCloudSettingsButton" Content="💾 Ayarları Kaydet" Width="Auto" HorizontalAlignment="Left"
                                            Padding="15,8" Margin="0,15,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Click="SaveCloudSettingsButton_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Otomatik Yedekleme Bölümü -->
                            <TextBlock Text="Otomatik Yedekleme (Auto-Backup)" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,30,0,10"/>
                            
                            <Border Background="#F8F9F9" Padding="20" CornerRadius="8" BorderBrush="#D5DBDB" BorderThickness="1">
                                <StackPanel>
                                    <CheckBox x:Name="EnableBackupCheckBox" Content="Uygulama kapanırken otomatik yedek al" FontSize="13" FontWeight="SemiBold" Foreground="#34495E" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                                    
                                    <StackPanel x:Name="BackupSettingsPanel">
                                        <TextBlock Text="Yedekleme Klasörü (Örn: G:\My Drive\Backups)" FontSize="12" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,5"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BackupPathTextBox" IsReadOnly="True" Padding="10" Background="White" BorderBrush="#D5DBDB" 
                                                     FontSize="12" Foreground="#34495E"/>
                                            <Button Grid.Column="1" Content="Klasör Seç" Padding="20,8" Margin="10,0,0,0" 
                                                    Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" 
                                                    Click="SelectBackupFolder_Click" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="5"/>
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <Grid MaxWidth="400" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Maks. Yedek Sayısı:" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" ToolTip="En fazla kaç adet yedek dosyası saklanacağını belirler."/>
                                                <TextBox x:Name="MaxBackupCountTextBox" Text="5" Padding="8" Background="White" BorderBrush="#D5DBDB" FontSize="13" HorizontalContentAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Maks. Saklama Günü:" FontSize="12" Foreground="#34495E" Margin="0,0,0,5" ToolTip="Bir yedek dosyasının en fazla kaç gün saklanacağını belirler."/>
                                                <TextBox x:Name="MaxBackupAgeTextBox" Text="30" Padding="8" Background="White" BorderBrush="#D5DBDB" FontSize="13" HorizontalContentAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Button x:Name="SaveBackupSettingsButton" Content="💾 Yedekleme Ayarlarını Kaydet" Width="Auto" HorizontalAlignment="Left"
                                            Padding="15,8" Margin="0,20,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Click="SaveBackupSettingsButton_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Hızlı Kurulum Klavuzu" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,30,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Google Drive" FontWeight="Bold" Foreground="#4285F4" Margin="0,0,0,5"/>
                                    <TextBlock Text="Drive Desktop uygulamasını açın ve 'G:\My Drive' klasörünü hedef gösterin." FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                    <TextBlock Text="OneDrive" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,5"/>
                                    <TextBlock Text="Kullanıcı klasörünüzdeki yerel OneDrive dizinini seçin." FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
