<UserControl x:Class="FinTrack.WPF.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinTrack.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Status color brushes -->
        <SolidColorBrush x:Key="GoodBrush"     Color="#4CAF50"/>
        <SolidColorBrush x:Key="WarningBrush"  Color="#FF9800"/>
        <SolidColorBrush x:Key="ExceededBrush" Color="#F44336"/>
        <SolidColorBrush x:Key="NeutralBrush"  Color="#9E9E9E"/>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title + nav -->
            <RowDefinition Height="Auto"/> <!-- CPI info bar -->
            <RowDefinition Height="*"/>    <!-- Budget list -->
            <RowDefinition Height="Auto"/> <!-- Edit panel -->
        </Grid.RowDefinitions>

        <!-- ── Row 0 : Title & Month Navigation ── -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📊 Bütçe Yönetimi" FontSize="22" FontWeight="Bold" Foreground="#333"/>
            </StackPanel>

            <!-- Month navigator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevMonthBtn" Content="◀" Width="36" Height="36"
                        Click="PrevMonth_Click" FontSize="14"
                        Background="#2C3E50" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBlock x:Name="MonthLabel" Text="Şubat 2026"
                           FontSize="18" FontWeight="SemiBold" Margin="15,0"
                           VerticalAlignment="Center" MinWidth="150" TextAlignment="Center"/>
                <Button x:Name="NextMonthBtn" Content="▶" Width="36" Height="36"
                        Click="NextMonth_Click" FontSize="14"
                        Background="#2C3E50" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="18"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ── Row 1 : TÜİK CPI Info Bar ── -->
        <Border Grid.Row="1" Background="#F3F9FF" BorderBrush="#BBDEFB" BorderThickness="1"
                CornerRadius="8" Padding="15,10" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CpiInfoText"
                           Text="📈 TÜİK TÜFE yükleniyor..."
                           VerticalAlignment="Center" Foreground="#1565C0" FontSize="14"/>
                <Button x:Name="RefreshCpiBtn" Grid.Column="1" Content="🔄 Verileri Güncelle"
                        Click="RefreshCpi_Click" Padding="15,5" FontSize="12"
                        Background="#1E88E5" Foreground="White" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ── Row 2 : Budget Cards List ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="BudgetList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,15,15" Padding="20" CornerRadius="12" Width="300"
                                BorderThickness="1" BorderBrush="#E0E0E0" Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Category name + status icon -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{Binding CategoryName}"
                                           FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding StatusIcon}"
                                           FontSize="18" VerticalAlignment="Center"/>
                                
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                                           Text="{Binding SpendingVsLimit}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{Binding StatusColor}"
                                           Margin="0,5,0,5"/>

                                <!-- Progress Bar -->
                                <ProgressBar Grid.Row="3" Grid.ColumnSpan="2"
                                             Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"
                                             Height="10" Margin="0,5"
                                             Foreground="{Binding StatusColor}"
                                             Background="#F0F0F0">
                                    <ProgressBar.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </ProgressBar.Resources>
                                </ProgressBar>

                                <!-- Info footer -->
                                <StackPanel Grid.Row="4" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ComparisonText}"
                                               FontSize="11" Foreground="#95A5A6" Margin="0,2"/>
                                    <TextBlock Text="{Binding InflationText}"
                                               FontSize="11" Foreground="{Binding RealDiffColor}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Row 3 : Edit Panel ── -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="12" Padding="20" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kategori Seçin" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CategoryCombo"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              FontSize="14" Height="40"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Aylık Limit (₺)" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBox x:Name="LimitInput" Height="40"
                             FontSize="16" VerticalContentAlignment="Center"
                             Padding="10,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Button x:Name="SaveLimitBtn" Grid.Column="4" Content="💾 Kaydet"
                        Width="100" Height="40" Click="SaveLimit_Click" FontSize="14" FontWeight="Bold"
                        Background="#27AE60" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="DeleteLimitBtn" Grid.Column="6" Content="🗑 Sil"
                        Width="100" Height="40" Click="DeleteLimit_Click" FontSize="14" FontWeight="Bold"
                        Background="#E74C3C" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="ClearBtn" Grid.Column="8" Content="✕ Vazgeç"
                        Width="100" Height="40" Click="ClearEdit_Click" FontSize="14"
                        Background="#95A5A6" Foreground="White" BorderThickness="0" VerticalAlignment="Bottom">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
