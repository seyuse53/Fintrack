<Window x:Class="FinTrack.WPF.Views.TaxCalculationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vergi Raporu" Height="700" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Başlık + Yıl Seçimi -->
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>  <!-- Özet Kartları -->
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>     <!-- Detay Tablosu -->
            <RowDefinition Height="Auto"/>  <!-- Uyarı + Kapat -->
        </Grid.RowDefinitions>

        <!-- Başlık + Yıl Seçimi -->
        <Grid Grid.Row="0">
            <TextBlock Text="📊 Yatırım Vergi Raporu" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Yıl:" FontSize="14" FontWeight="SemiBold" Foreground="#7F8C8D" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="YearComboBox" Width="100" FontSize="14" Padding="10,6" SelectionChanged="Year_Changed"/>
            </StackPanel>
        </Grid>

        <!-- Özet Kartları -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Toplam Kazanç -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Toplam Kazanç" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalGainText" Text="₺0" FontSize="22" FontWeight="Bold" Foreground="#27AE60" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Tahmini Vergi -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Tahmini Vergi" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalTaxText" Text="₺0" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Temettü Geliri -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Temettü Geliri (Brüt)" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TotalDividendText" Text="₺0" FontSize="22" FontWeight="Bold" Foreground="#F39C12" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Net Getiri -->
            <Border Grid.Column="6" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect><DropShadowEffect Color="#000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
                <StackPanel>
                    <TextBlock Text="Net Getiri (Vergi Sonrası)" FontSize="12" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                    <TextBlock x:Name="NetReturnText" Text="₺0" FontSize="22" FontWeight="Bold" Foreground="#2980B9" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Detay Tablosu -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="📋 İşlem Detayları" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock x:Name="TransactionCountText" Text="" FontSize="13" Foreground="#95A5A6" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                </StackPanel>

                <DataGrid x:Name="TaxDetailsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="White" RowBackground="White"
                          AlternatingRowBackground="#FAFBFC" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="85"/>
                        <DataGridTextColumn Header="Varlık" Binding="{Binding AssetName}" Width="120"/>
                        <DataGridTemplateColumn Header="Tür" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeText}" FontWeight="Bold" Foreground="{Binding TypeColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Adet" Binding="{Binding Amount, StringFormat=N2}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Alım Maliyeti" Binding="{Binding BuyCost, StringFormat='₺{0:N2}'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Satış Geliri" Binding="{Binding SellRevenue, StringFormat='₺{0:N2}'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Kazanç" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GainText}" FontWeight="Bold" Foreground="{Binding GainColor}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Vergi Oranı" Binding="{Binding TaxRateText}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Tahmini Vergi" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TaxAmount, StringFormat='₺{0:N2}'}" FontWeight="SemiBold" Foreground="#E74C3C" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Uyarı + Kapat -->
        <Grid Grid.Row="5" Margin="0,15,0,0">
            <Border Background="#FEF9E7" CornerRadius="8" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Bu rapor bilgilendirme amaçlıdır, kesin vergi tavsiyesi niteliğinde değildir." FontSize="12" Foreground="#8D6E0F" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Button Content="Kapat" HorizontalAlignment="Right" Width="100" Padding="10" Click="Close_Click" Background="#BDC3C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
