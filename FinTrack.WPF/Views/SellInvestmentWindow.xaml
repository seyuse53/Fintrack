<Window x:Class="FinTrack.WPF.Views.SellInvestmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yatırım Sat" SizeToContent="Height" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Kar/Zarar Önizlemesi -->
            <RowDefinition Height="Auto"/>  <!-- Butonlar -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Yatırım Satışı" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock x:Name="AssetInfoText" Text="Varlık: Yükleniyor..." FontSize="14" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock x:Name="AvailableAmountText" Text="Satılabilir Miktar: 0" FontSize="12" Foreground="#7F8C8D"/>
                <TextBlock x:Name="AvgCostInfoText" Text="" FontSize="12" Foreground="#7F8C8D" Margin="15,0,0,0"/>
            </StackPanel>

            <!-- İşlem Tarihi -->
            <TextBlock Text="İşlem Tarihi" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,10,0,5"/>
            <DatePicker x:Name="TransactionDatePicker" Padding="8" FontSize="14" Margin="0,0,0,15" SelectedDateFormat="Short"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                    
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Satılacak Miktar" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <Button x:Name="SellAllButton" Content="Tümünü Sat" FontSize="10" Padding="6,2" Margin="10,0,0,0"
                                Background="#F39C12" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Click="SellAllButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                    <TextBox x:Name="AmountTextBox" Padding="10" FontSize="14" TextChanged="NumberTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Birim Fiyatı (₺)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="UnitPriceTextBox" Padding="10" FontSize="14" TextChanged="NumberTextBox_TextChanged"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Aracı Kurum Masrafı / Komisyon (₺)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="FeeTextBox" Padding="10" FontSize="14" Margin="0,0,0,15" Text="0" TextChanged="NumberTextBox_TextChanged"/>

            <TextBlock Text="Satış Gelirinin Aktarılacağı Hesap (İsteğe Bağlı)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock Text="Seçilen hesabın bakiyesi otomatik olarak artırılacaktır." FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <ComboBox x:Name="BankAccountComboBox" Padding="10" FontSize="14" Margin="0,0,0,10" DisplayMemberPath="DisplayInfo" SelectedValuePath="Id"/>
        </StackPanel>

        <!-- Kar/Zarar Önizlemesi -->
        <Border x:Name="ProfitPreviewBorder" Grid.Row="2" CornerRadius="8" Padding="15" Margin="0,5,0,0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tahmini Gelir:" FontSize="12" Foreground="#7F8C8D"/>
                    <TextBlock x:Name="RevenuePreviewText" Text="₺0,00" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Kar / Zarar:" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ProfitPreviewText" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="90" Padding="10" Click="Cancel_Click" Background="#ECF0F1" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Satışı Tamamla" Width="120" Padding="10" Click="Save_Click" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
