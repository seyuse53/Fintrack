<UserControl x:Class="FinTrack.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinTrack.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Summary Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content (Grids) -->
        </Grid.RowDefinitions>

        <!-- Summary Cards Row -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Income Card -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Toplam Gelir" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="IncomeCardText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
            </Border>

            <!-- Total Expense Card -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Toplam Gider" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ExpenseCardText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/>
                </StackPanel>
            </Border>

            <!-- Remaining Balance Card -->
            <Border Grid.Column="4" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Toplam Varlık (Nakit + Banka)" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                    <TextBlock x:Name="BalanceCardText" Text="₺0,00" FontSize="24" FontWeight="Bold" Foreground="#2980B9"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Split View (Income / Expense) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> <!-- Income -->
                <ColumnDefinition Width="20"/> <!-- Spacer -->
                <ColumnDefinition Width="*"/> <!-- Expense -->
            </Grid.ColumnDefinitions>

            <!-- INCOME SECTION -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/> <!-- Changed to Auto for ScrollViewer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="🟢 ALACAK (BU AY)" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/>
                        
                        <DataGrid x:Name="IncomeGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" 
                                  AlternatingRowBackground="#F9FAF9" BorderThickness="0" MinHeight="150" MaxHeight="400">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Düzenle" Click="EditTransaction_Click"/>
                                <MenuItem Header="Sil" Click="DeleteTransaction_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category.FullDisplayName}" Width="110"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat='+ ₺{0:N2}'}" Width="100" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Credit Card Summary Panel -->
                    <Border Grid.Row="3" Background="#F8F9F9" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Text="💳 KART TOPLAMLARI" Grid.Row="0" FontWeight="Bold" FontSize="12" Foreground="#34495E" Margin="0,0,0,8"/>
                            
                            <ListBox x:Name="CardSummaryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     SelectionChanged="CardSummaryList_SelectionChanged" Cursor="Hand" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EDF1F2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel x:Name="ItemPanel">
                                            <TextBlock x:Name="AmountText" Text="{Binding Total, StringFormat='₺{0:N0}'}"
                                                       DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#2C3E50" Margin="4,0,0,0"/>
                                            <TextBlock x:Name="LabelText" Text="{Binding Label}" Foreground="#7F8C8D" FontSize="12"/>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                <Setter TargetName="LabelText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="AmountText" Property="FontWeight" Value="Bold"/>
                                                <Setter TargetName="LabelText" Property="Foreground" Value="#34495E"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Separator Grid.Row="2" Margin="0,8" Background="#BDC3C7"/>
                            
                            <DockPanel Grid.Row="3">
                                <TextBlock x:Name="TotalCardLabel" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#2C3E50" FontSize="14"/>
                                <TextBlock Text="G.Toplam:" FontWeight="Bold" Foreground="#34495E" FontSize="14"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- EXPENSE SECTION -->
            <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/> <!-- Changed to Auto -->
                            <RowDefinition Height="Auto"/> <!-- For Bill Distribution -->
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Text="🔴 BORÇ (BU AY)" FontSize="16" FontWeight="Bold" Foreground="#E74C3C"/>
                        
                        <DataGrid x:Name="ExpenseGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" 
                                  AlternatingRowBackground="#FFF9F9" BorderThickness="0" MinHeight="300">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Düzenle" Click="EditTransaction_Click"/>
                                <MenuItem Header="Sil" Click="DeleteTransaction_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat=d}" Width="90"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding Category.FullDisplayName}" Width="110"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Tutar" Binding="{Binding Amount, StringFormat='- ₺{0:N2}'}" Width="100" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bill Distribution Panel moved to Expense Section -->
                    <Border Grid.Row="3" x:Name="BillDistributionPanel" Visibility="Collapsed" Background="#F4F9FF" BorderBrush="#D6EAF8" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="⚡ FATURA DAĞILIMI" FontWeight="Bold" FontSize="12" Foreground="#2980B9" Margin="0,0,0,8"/>
                            <ListBox x:Name="BillBreakdownList" Grid.Row="1" Background="Transparent" BorderThickness="0" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Foreground="#34495E" FontSize="12"/>
                                            <TextBlock Text="{Binding Total, StringFormat='₺{0:N2}'}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#2980B9" FontSize="12"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
