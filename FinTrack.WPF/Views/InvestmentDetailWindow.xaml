<Window x:Class="FinTrack.WPF.Views.InvestmentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FinTrack.WPF.Controls"
        Title="Yatırım Detayı" Height="780" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F4F6F9">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Varlık Bilgi Kartı -->
            <RowDefinition Height="15"/>    <!-- Spacer -->
            <RowDefinition Height="Auto"/>  <!-- Sparkline Grafik -->
            <RowDefinition Height="15"/>    <!-- Spacer -->
            <RowDefinition Height="*"/>     <!-- İşlem Geçmişi -->
            <RowDefinition Height="Auto"/>  <!-- Alt Özet -->
            <RowDefinition Height="Auto"/>  <!-- Butonlar -->
        </Grid.RowDefinitions>

        <!-- Varlık Bilgi Kartı -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="25">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="12" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Ad, Sembol, Kategori -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AssetNameText" Text="Varlık Adı" FontSize="22" FontWeight="Bold" Foreground="#2C3E50"/>
                        <TextBlock x:Name="AssetSymbolText" Text="(SYM)" FontSize="16" Foreground="#95A5A6" VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <TextBlock x:Name="AssetCategoryText" Text="Kategori" FontSize="13" Foreground="#8E44AD" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Sağ: Metrikler -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Toplam Adet" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TotalAmountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Ort. Maliyet" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="AvgCostText" Text="₺0" FontSize="18" FontWeight="Bold" Foreground="#34495E" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="Güncel Fiyat" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentPriceText" Text="₺0" FontSize="18" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sparkline Fiyat Grafiği -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="160"/>
                </Grid.RowDefinitions>

                <!-- Başlık + Periyod Butonları -->
                <Grid Grid.Row="0">
                    <TextBlock Text="📊 Fiyat Grafiği" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton x:Name="Period30" Content="1A" GroupName="Period" Checked="Period_Changed"
                                     Style="{StaticResource PeriodButton}" Margin="0,0,5,0"/>
                        <RadioButton x:Name="Period90" Content="3A" GroupName="Period" Checked="Period_Changed" IsChecked="True"
                                     Style="{StaticResource PeriodButton}" Margin="0,0,5,0"/>
                        <RadioButton x:Name="Period365" Content="1Y" GroupName="Period" Checked="Period_Changed"
                                     Style="{StaticResource PeriodButton}" Margin="0,0,5,0"/>
                        <RadioButton x:Name="PeriodAll" Content="Tümü" GroupName="Period" Checked="Period_Changed"
                                     Style="{StaticResource PeriodButton}"/>
                    </StackPanel>
                </Grid>

                <!-- Sparkline -->
                <controls:SparklineControl x:Name="PriceChart" Grid.Row="2"
                    ShowFill="True" ShowLabels="True" ShowTooltip="True"/>
            </Grid>
        </Border>

        <!-- İşlem Geçmişi -->
        <Border Grid.Row="4" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 İşlem Geçmişi" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
                <DataGrid x:Name="TransactionsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column" Background="White" RowBackground="White"
                          AlternatingRowBackground="#FAFBFC" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" Width="95"/>
                        <DataGridTemplateColumn Header="Tür" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TypeText}" FontWeight="Bold" Foreground="{Binding TypeColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Adet" Binding="{Binding Amount, StringFormat=N2}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, StringFormat='₺{0:N2}'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Komisyon" Binding="{Binding Fee, StringFormat='₺{0:N2}'}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Toplam" Binding="{Binding TotalCost, StringFormat='₺{0:N2}'}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Hesap" Binding="{Binding AccountName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Alt Özet -->
        <Border Grid.Row="5" Background="White" CornerRadius="12" Padding="20" Margin="0,15,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.04" BlurRadius="8" ShadowDepth="1"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Toplam Alım" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalBuyText" Text="₺0" FontSize="16" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Toplam Satış" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalSellText" Text="₺0" FontSize="16" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Komisyon Toplamı" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalFeeText" Text="₺0" FontSize="16" FontWeight="Bold" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Net Kar/Zarar" FontSize="11" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="NetProfitText" Text="₺0" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Butonlar -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="📊 Sermaye İşlemi" Padding="12,10" Click="CapitalAction_Click" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="💰 Temettü Kaydet" Padding="12,10" Click="AddDividend_Click" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Kapat" Width="100" Padding="10" Click="Close_Click" Background="#BDC3C7" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>

    <Window.Resources>
        <!-- Periyod buton stili -->
        <Style x:Key="PeriodButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#F0F3F4" CornerRadius="6" Padding="12,6" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#2E86C1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
        </Style>
    </Window.Resources>
</Window>
