<Window x:Class="FinTrack.WPF.Views.EditInvestmentAssetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Varlık Düzenle" SizeToContent="Height" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Varlık Bilgilerini Düzenle" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Sembol" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="SymbolTextBox" Padding="10" FontSize="14" CharacterCasing="Upper" Margin="0,0,0,15"/>

            <TextBlock Text="Varlık Adı" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="NameTextBox" Padding="10" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="Kategori" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CategoryComboBox" Padding="10" FontSize="14" Margin="0,0,0,15">
                <ComboBoxItem Content="Altın"/>
                <ComboBoxItem Content="Döviz"/>
                <ComboBoxItem Content="Hisse Senedi"/>
                <ComboBoxItem Content="Kripto Para"/>
                <ComboBoxItem Content="Fon"/>
                <ComboBoxItem Content="Diğer"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="90" Padding="10" Click="Cancel_Click" Background="#ECF0F1" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="💾 Kaydet" Width="120" Padding="10" Click="Save_Click" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
