<Window x:Class="FinTrack.WPF.Views.AddDividendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temettü Kaydet" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F6F9">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>  <!-- Net Temettü Önizlemesi -->
            <RowDefinition Height="Auto"/>  <!-- Butonlar -->
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="💰 Temettü (Kâr Payı) Kaydı" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock x:Name="AssetInfoText" Text="Varlık: Yükleniyor..." FontSize="13" Foreground="#7F8C8D" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <!-- İşlem Tarihi -->
            <TextBlock Text="Temettü Tarihi" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <DatePicker x:Name="DividendDatePicker" Padding="8" FontSize="14" Margin="0,0,0,15" SelectedDateFormat="Short"/>

            <!-- Brüt Temettü -->
            <TextBlock Text="Brüt Temettü Tutarı (₺)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="GrossDividendTextBox" Padding="10" FontSize="14" Margin="0,0,0,15" TextChanged="Dividend_TextChanged"/>

            <!-- Stopaj Oranı -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Stopaj Oranı (%)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="WithholdingRateTextBox" Padding="10" FontSize="14" Text="10" TextChanged="Dividend_TextChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Stopaj Tutarı (₺)" FontSize="12" Foreground="#95A5A6" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="WithholdingAmountText" Text="₺0,00" FontSize="14" Foreground="#95A5A6" Padding="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Hedef Hesap -->
            <TextBlock Text="Temettü Gelirinin Aktarıldığı Hesap (İsteğe Bağlı)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="BankAccountComboBox" Padding="10" FontSize="14" Margin="0,0,0,10" DisplayMemberPath="DisplayInfo" SelectedValuePath="Id"/>
        </StackPanel>

        <!-- Net Temettü Önizlemesi -->
        <Border Grid.Row="2" Background="#FEF9E7" CornerRadius="8" Padding="15" Margin="0,5,0,0" BorderBrush="#F9E79F" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Net Temettü Geliri:" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                <TextBlock x:Name="NetDividendPreviewText" Grid.Column="1" Text="₺0,00" FontSize="18" FontWeight="Bold" Foreground="#F39C12" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="90" Padding="10" Click="Cancel_Click" Background="#ECF0F1" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="💰 Kaydet" Width="120" Padding="10" Click="Save_Click" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
