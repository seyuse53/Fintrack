<UserControl x:Class="FinTrack.WPF.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and Manage Button -->
            <RowDefinition Height="*"/>    <!-- Accounts Grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Banka Hesapları" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button x:Name="ManageAccountsButton" Content="⚙️ Hesapları Yönet" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="15,8" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="ManageAccountsButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Dynamic List of Accounts -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AccountsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="300" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Account Border -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,20,20" Padding="20">
                            <!-- Card Shadow Effect -->
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Bank Name -->
                                    <RowDefinition Height="5"/>
                                    <RowDefinition Height="Auto"/> <!-- Account Name/IBAN -->
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/> <!-- Current Balance -->
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <TextBlock Grid.Row="0" Text="{Binding BankName}" FontSize="16" FontWeight="Bold" Foreground="#27AE60"/>
                                <TextBlock Grid.Row="2" Text="{Binding AccountName}" FontSize="13" Foreground="#34495E" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="2" Text="{Binding IBAN}" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                <!-- Balance Info -->
                                <StackPanel Grid.Row="4" Margin="0,5,0,0">
                                    <TextBlock Text="Güncel Bakiye" FontSize="12" Foreground="#95A5A6"/>
                                    <TextBlock Text="{Binding CurrentBalance, StringFormat='₺{0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="6" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="📝 Hareketler" Tag="{Binding AccountId}" Click="DetailButton_Click"
                                            Padding="0,8" Background="#F8F9F9" Foreground="#2C3E50" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#BDC3C7" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="🔄 Transfer" Tag="{Binding AccountId}" Click="TransferButton_Click"
                                            Padding="0,8" Background="#2980B9" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
