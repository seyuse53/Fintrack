<Window x:Class="FinTrack.WPF.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Sürüm Mevcut!" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık Kısmı -->
            <Border Grid.Row="0" Background="#3498DB" CornerRadius="15,15,0,0" Padding="20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Harika Haber! Yeni Bir Sürüm Var" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Versiyon Bilgisi -->
            <StackPanel Grid.Row="1" Margin="30,20,30,10">
                <TextBlock x:Name="CurrentVersionText" Text="Mevcut Sürüm: 0.9.1" FontSize="14" Foreground="#7F8C8D"/>
                <TextBlock x:Name="NewVersionText" Text="Yeni Sürüm: 1.0.0" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Sürüm Notları (Release Notes) -->
            <Border x:Name="ReleaseNotesBorder" Grid.Row="2" Margin="30,10,30,20" Background="#F8F9F9" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Sürüm Notları:" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ReleaseNotesText" Text="-" TextWrapping="Wrap" Foreground="#2C3E50" FontSize="13"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- İndirme Durumu (Sürüm Notları Gizlendiğinde Görünür) -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="30,0">
                <TextBlock x:Name="DownloadProgressText" Text="" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2980B9" Visibility="Collapsed" Margin="0,0,0,15"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="10" Visibility="Collapsed">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- Butonlar -->
            <Grid Grid.Row="3" Margin="30,0,30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RemindLaterButton" Grid.Column="0" Content="Daha Sonra Hatırlat" Padding="10" 
                        Background="White" Foreground="#7F8C8D" FontWeight="Bold" 
                        BorderBrush="#E0E0E0" BorderThickness="1" Cursor="Hand"
                        Click="RemindLaterButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="UpdateNowButton" Grid.Column="2" Content="Şimdi Güncelle" Padding="10" 
                        Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="UpdateNowButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
