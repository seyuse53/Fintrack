<UserControl x:Class="FinTrack.WPF.Views.CardsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- No converters needed for simple triggers -->
    </UserControl.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header and Manage Button -->
            <RowDefinition Height="*"/>    <!-- Cards Grid -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Kredi Kartları Özeti" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
            <Button x:Name="ManageCardsButton" Content="⚙️ Kartları Yönet" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="15,8" Background="#34495E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                    Click="ManageCardsButton_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <!-- Dynamic List of Cards via ItemsControl wrapped in ScrollViewer -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CardsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="300" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Card Border -->
                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,20,20" Padding="20">
                            <!-- Card Shadow Effect -->
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Bank Name -->
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/> <!-- Card Label & Debt -->
                                    <RowDefinition Height="Auto"/> <!-- Progress Bar -->
                                    <RowDefinition Height="15"/>
                                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Header Area -->
                                <TextBlock Grid.Row="0" Text="{Binding BankName}" FontSize="16" FontWeight="Bold" Foreground="#2980B9"/>
                                <TextBlock Grid.Row="0" Text="{Binding CardLabel}" FontSize="13" Foreground="#7F8C8D" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                <!-- Linked Cards Hint -->
                                <TextBlock Grid.Row="2" Text="{Binding LinkedCardsText}" FontSize="10" Foreground="#BDC3C7" Margin="0,0,0,5" VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Debt Info -->
                                <StackPanel Grid.Row="2" Margin="0,15,0,10">
                                    <TextBlock Text="Mevcut Dönem Borcu" FontSize="12" Foreground="#95A5A6"/>
                                    <TextBlock Text="{Binding TotalDebt, StringFormat='₺{0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="#E74C3C"/>
                                </StackPanel>

                                <!-- Progress Bar and Description -->
                                <StackPanel Grid.Row="3" Margin="0,5,0,0">
                                    <Grid Margin="0,0,0,5">
                                        <TextBlock Text="{Binding StatementDescription}" FontSize="11" Foreground="#34495E" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding DaysRemainingText}" FontSize="11" Foreground="#C0392B" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="6" Background="#ECF0F1" Foreground="{Binding ProgressColor}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid Grid.Row="5" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="🔍 Detay" Tag="{Binding CardId}" Click="DetailButton_Click"
                                            Padding="0,8" Background="#F8F9F9" Foreground="#2C3E50" FontWeight="SemiBold" BorderThickness="1" BorderBrush="#BDC3C7" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Grid.Column="2" Content="💸 Borç Öde" Tag="{Binding CardId}" Click="PayButton_Click" IsEnabled="{Binding CanPay}"
                                            Padding="0,8" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
