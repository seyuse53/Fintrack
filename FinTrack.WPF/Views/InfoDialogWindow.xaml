<Window x:Class="FinTrack.WPF.Views.InfoDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilgi" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Viewbox Width="28" Height="28">
                    <!-- Information Icon (Blue) -->
                    <Path x:Name="IconPath" Data="M11,9H13V11H11V9M11,13H13V17H11V13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" Fill="#3498DB"/>
                </Viewbox>
                <TextBlock x:Name="TitleText" Text="Bilgi" FontSize="17" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="Bilgi Mesajı" 
                       FontSize="14" Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,25" LineHeight="20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Tamam" Width="100" Height="32" 
                        Click="Ok_Click" Background="#3498DB" Foreground="White" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
