<Window x:Class="FinTrack.WPF.DeleteDataConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Son Onay: Veri Kaybı Riski" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Border Margin="15" Background="White" CornerRadius="12" BorderBrush="#FFCCD1" BorderThickness="1.5">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Viewbox Width="32" Height="32">
                    <Path Data="M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z" Fill="#E74C3C"/>
                </Viewbox>
                <TextBlock Text="Kritik Uyarı" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <TextBlock x:Name="MessageText" Text="Bu profile ait veritabanı dosyası (harcamalar, hesaplar vb.) da silinsin mi?" 
                       FontSize="14" Foreground="#333" TextWrapping="Wrap" Margin="0,0,0,10"/>
            
            <TextBlock Text="'Evet' derseniz tüm kayıtlarınız geri döndürülemez şekilde silinecektir." 
                       FontSize="13" Foreground="#666" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,25"/>

            <StackPanel Orientation="Vertical">
                <Button Content="Evet, Verileri de Kalıcı Olarak Sil" Height="35" Margin="0,0,0,10" 
                        Click="Yes_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold" BorderThickness="0">
                     <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="Hayır, Sadece Profili Kaldır (Veriler Kalsın)" Height="35" Margin="0,0,0,10" 
                        Click="No_Click" Background="White" Foreground="#333" BorderBrush="#CCC">
                     <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="CancelProcessButton" Height="30" Click="Cancel_Click" Background="Transparent" Foreground="#777" BorderThickness="0">
                    <TextBlock Text="İşlemi Tamamen İptal Et" TextDecorations="Underline"/>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
