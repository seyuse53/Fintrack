<Window x:Class="FinTrack.WPF.CardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kart Harcama Detayı" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock x:Name="TitleText" Grid.Row="0"
                   FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- Subtitle (month + total) -->
        <TextBlock x:Name="SubtitleText" Grid.Row="1"
                   FontSize="13" Foreground="#555" Margin="0,0,0,12"/>

        <!-- Transactions list -->
        <DataGrid x:Name="TransactionsGrid" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="White" RowBackground="White"
                  AlternatingRowBackground="#FFF8E1"
                  CanUserReorderColumns="False"
                  MouseDoubleClick="TransactionsGrid_MouseDoubleClick">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🗑 Seçili İşlemi Sil" Click="DeleteTransaction_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarih"     Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="80"/>
                <DataGridTextColumn Header="Kart"      Binding="{Binding CreditCardAccount.CardLabel}" Width="90"/>
                <DataGridTextColumn Header="Kategori"  Binding="{Binding Category.Name}" Width="100"/>
                <DataGridTextColumn Header="Açıklama"  Binding="{Binding Description}"   Width="*"/>
                <DataGridTextColumn Header="Tutar"     Binding="{Binding FormattedAmount}" Width="95" FontWeight="Bold">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"   Value="{Binding ForegroundColor}"/>
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Close button & Pay button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PayButton" Content="💸 Borç Öde" Width="100" Padding="5" Margin="0,0,10,0"
                    Background="#4CAF50" Foreground="White" BorderThickness="0"
                    Click="Pay_Click" Visibility="Collapsed"/>
            <Button Content="Kapat" Width="80" Padding="5" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
