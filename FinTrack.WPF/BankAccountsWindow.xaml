<Window x:Class="FinTrack.WPF.BankAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏦 Banka Hesaplarım" Height="480" Width="550"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
        
    <Window.Resources>
        <!-- Custom Style for TextBox with Watermark -->
        <Style x:Key="WatermarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                <TextBlock x:Name="WatermarkText" Text="{TemplateBinding Tag}" Foreground="#A0A0A0" 
                                           Margin="5,2,0,0" IsHitTestVisible="False" VerticalAlignment="Center" 
                                           Visibility="Collapsed" FontStyle="Italic"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="WatermarkText" Property="Visibility" Value="Visible"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>        
        
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏦 Banka Hesapları Yönetimi" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Account list -->
        <DataGrid x:Name="AccountsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,0,0,10"
                  SelectionChanged="AccountsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Banka" Binding="{Binding BankName}" Width="*"/>
                <DataGridTextColumn Header="Hesap Adı/Türü" Binding="{Binding AccountName}" Width="*"/>
                <DataGridTextColumn Header="Açılış Bakiyesi" Binding="{Binding InitialBalance, StringFormat='₺{0:N2}'}" Width="110"/>
                <DataGridTextColumn Header="IBAN" Binding="{Binding IBAN}" Width="100"/>
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="45"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit panel -->
        <Border Grid.Row="2" BorderBrush="#AAA" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10" Background="#F9F9F9">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="BankNameBox" Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="Banka Adı (örn. Garanti)" FontSize="12"
                             ToolTip="Banka Adı (örn. Garanti BBVA)" TextChanged="InputBox_TextChanged"/>
                    <TextBox x:Name="AccountNameBox" Grid.Column="2" Style="{StaticResource WatermarkTextBox}" Tag="Hesap / Kart Türü" FontSize="12"
                             ToolTip="Hesap Türü (örn. Maaş Hesabı)" TextChanged="InputBox_TextChanged"/>
                    <TextBox x:Name="InitialBalanceBox" Grid.Column="4" Style="{StaticResource WatermarkTextBox}" Tag="Açılış ₺" FontSize="12"
                             ToolTip="Açılış Bakiyesi" TextChanged="InputBox_TextChanged"/>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="IbanBox" Grid.Column="0" Style="{StaticResource WatermarkTextBox}" Tag="IBAN (İsteğe Bağlı)" FontSize="12"
                             ToolTip="IBAN Numarası (İsteğe Bağlı)" TextChanged="IbanBox_TextChanged"/>
                    
                    <Button x:Name="AddAccountBtn" Grid.Column="2" Content="➕ Ekle" FontSize="11"
                            Padding="6,4" Background="#27AE60" Foreground="White" BorderThickness="0"
                            Click="AddAccount_Click" IsEnabled="False"/>
                    <Button x:Name="UpdateAccountBtn" Grid.Column="4" Content="💾 Güncelle" FontSize="11"
                            Padding="6,4" Background="#2980B9" Foreground="White" BorderThickness="0"
                            Click="UpdateAccount_Click" IsEnabled="False"/>
                    <Button x:Name="ToggleActiveBtn" Grid.Column="6" Content="🔄 Aktif" FontSize="11"
                            Padding="6,4" Background="#F39C12" Foreground="White" BorderThickness="0"
                            Click="ToggleActive_Click" IsEnabled="False"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteAccountBtn" Content="🗑️ Sil" Width="80" Padding="5"
                    Margin="0,0,10,0" Background="#E74C3C" Foreground="White" BorderThickness="0"
                    Click="DeleteAccount_Click" IsEnabled="False"/>
            <Button Content="Kapat" Width="80" Padding="5" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
