<Window x:Class="FinTrack.WPF.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinTrack.WPF"
        mc:Ignorable="d"
        Title="İşlem Ekle" Height="390" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Yeni İşlem Ekle" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Date -->
        <TextBlock Text="Tarih:" Grid.Row="1" VerticalAlignment="Center"/>
        <DatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                    SelectedDate="{x:Static System:DateTime.Now}"
                    xmlns:System="clr-namespace:System;assembly=mscorlib"/>

        <!-- Amount -->
        <TextBlock Text="Tutar:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="AmountTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="2" TextChanged="AmountTextBox_TextChanged"/>

        <!-- Category: color-coded by type -->
        <TextBlock Text="Kategori:" Grid.Row="3" VerticalAlignment="Center"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                  SelectedValuePath="Id">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Payment Method (Cash or Card) -->
        <TextBlock Text="Ödeme Yöntemi:" Grid.Row="4" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox x:Name="PaymentMethodCombo" SelectionChanged="PaymentMethod_Changed">
                <!-- Populated in code-behind: "Nakit" + active cards -->
            </ComboBox>
            
            <!-- Installment Toggle -->
            <StackPanel x:Name="InstallmentPanel" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                <CheckBox x:Name="IsInstallmentCheckBox" Content="Taksitli İșlem" VerticalAlignment="Center" Cursor="Hand" Checked="IsInstallment_Toggled" Unchecked="IsInstallment_Toggled"/>
                <TextBlock Text="Taksit:" Margin="10,0,5,0" VerticalAlignment="Center" x:Name="InstallmentCountLabel" Visibility="Collapsed"/>
                <ComboBox x:Name="InstallmentCountCombo" Width="50" Visibility="Collapsed">
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3" IsSelected="True"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="5"/>
                    <ComboBoxItem Content="6"/>
                    <ComboBoxItem Content="9"/>
                    <ComboBoxItem Content="12"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Description -->
        <TextBlock Text="Açıklama:" Grid.Row="5" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="İptal" Width="80" Margin="0,0,10,0"
                    Padding="5" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Kaydet" Width="80" Padding="5"
                    Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
