<Window x:Class="FinTrack.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinTrack.WPF"
        mc:Ignorable="d"
        Title="FinTrack - Kişisel Finans Takip" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app_icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="220"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#2C3E50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo/Title -->
                    <RowDefinition Height="Auto"/> <!-- Main Menu -->
                    <RowDefinition Height="*"/>    <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Bottom Menu/Settings -->
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="20,30,20,40">
                    <TextBlock Text="FinTrack" FontSize="26" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                    <TextBlock Text="Kişisel Finans Takip" FontSize="12" Foreground="#95A5A6" TextAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Main Menu Items -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <!-- Dashboard (Current Main View) -->
                    <Button x:Name="DashboardButton" Content="🏠 Ana Ekran (Özet)" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="DashboardButton_Click" Background="#34495E" Foreground="White" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BudgetButton" Content="📊 Bütçe" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="BudgetButton_Click" Background="Transparent" Foreground="#ECF0F1" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="CardsButton" Content="💳 Kartlarım" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="CardsButton_Click" Background="Transparent" Foreground="#ECF0F1" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Accounts button -->
                    <Button x:Name="AccountsButton" Content="🏦 Hesaplarım" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="AccountsButton_Click" Background="Transparent" Foreground="#ECF0F1" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <!-- Investments button -->
                    <Button x:Name="InvestmentsButton" Content="📈 Yatırımlar" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="InvestmentsButton_Click" Background="Transparent" Foreground="#ECF0F1" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <!-- Reports button -->
                    <Button x:Name="ReportsButton" Content="📉 Raporlar" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="ReportsButton_Click" Background="Transparent" Foreground="#ECF0F1" BorderThickness="0" Margin="0,0,0,5">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Bottom Menu -->
                <StackPanel Grid.Row="3" Margin="10,0,10,20">
                    <Button x:Name="SettingsButton" Content="⚙️ Ayarlar" Padding="15,12" FontSize="14" HorizontalContentAlignment="Left"
                            Click="SettingsButton_Click" Background="Transparent" Foreground="#95A5A6" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Background="#F4F6F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Bar -->
                <RowDefinition Height="*"/>    <!-- Actual Content -->
                <RowDefinition Height="Auto"/> <!-- Status Bar -->
            </Grid.RowDefinitions>

            <!-- Top Bar (Contextual Header + Add Button) -->
            <Grid Grid.Row="0" Margin="20,20,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="ViewTitle" Text="Ana Ekran (Özet)" FontSize="24" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Global Date Filter -->
                    <Border x:Name="GlobalDateFilterPanel" Background="#F8F9F9" CornerRadius="8" Padding="12,6" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="15"/>
                            <ComboBox x:Name="MonthFilter" Width="120" Margin="0,0,10,0" 
                                      SelectionChanged="Filter_SelectionChanged"
                                      Background="White" BorderBrush="#BDC3C7" Foreground="#2C3E50" 
                                      Padding="8,4" VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </ComboBox.Resources>
                            </ComboBox>
                            <ComboBox x:Name="YearFilter" Width="90" 
                                      SelectionChanged="Filter_SelectionChanged"
                                      Background="White" BorderBrush="#BDC3C7" Foreground="#2C3E50" 
                                      Padding="8,4" VerticalContentAlignment="Center" FontSize="14" FontWeight="SemiBold">
                                    <ComboBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Button x:Name="AddButton" Content="+ Yeni İşlem Ekle" Padding="20,8" FontSize="14" FontWeight="Bold"
                            Click="AddButton_Click" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="20"/> <!-- Pill shape -->
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Main Content Area (Dynamic) -->
            <ContentControl x:Name="MainContentArea" Grid.Row="1"/>

            <!-- Status Bar -->
            <StatusBar Grid.Row="2" Background="#ECF0F1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <TextBlock x:Name="StatusText" Text="Hazır" Foreground="#7F8C8D"/>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionText" Text="v0.9.4" Foreground="#95A5A6" Margin="0,0,10,0" FontSize="11"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </Grid>
</Window>
