<Window x:Class="FinTrack.WPF.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kurtarma Kodunuz" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="WhiteSmoke">
    <Grid Margin="15" Background="White">
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="⚠️ ÇOK ÖNEMLİ ⚠️" FontSize="18" FontWeight="Bold" Foreground="DarkRed" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <TextBlock Text="Aşağıdaki kod, şifrenizi unutmanız durumunda verilerinize erişebilmeniz için TEK YOLDUR. Lütfen bu kodu güvenli bir yere kopyalayıp saklayın." TextWrapping="Wrap" TextAlignment="Center" Foreground="#555" Margin="0,0,0,15"/>
                
                <TextBox x:Name="RecoveryCodeTextBox" Text="XXXX-YYYY-ZZZZ-WWWW" FontSize="18" FontWeight="Bold" Foreground="#333" Background="#F0F8FF" TextAlignment="Center" IsReadOnly="True" Padding="10" Margin="0,0,0,15"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CopyButton" Content="Panoya Kopyala" Width="120" Height="35" FontSize="14" FontWeight="Bold" Background="#007ACC" Foreground="White" BorderThickness="0" Click="CopyButton_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="OkButton" Content="Tamam, Kaydettim" Width="140" Height="35" FontSize="14" FontWeight="Bold" Background="#28A745" Foreground="White" BorderThickness="0" Click="OkButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
