<Window x:Class="FinTrack.WPF.CreditCardAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="💳 Kartlarım" Height="480" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💳 Kredi Kartı Hesapları" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Card list -->
        <DataGrid x:Name="CardsGrid" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" IsReadOnly="True"
                  SelectionMode="Single" Margin="0,0,0,10"
                  SelectionChanged="CardsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Banka" Binding="{Binding BankName}" Width="*"/>
                <DataGridTextColumn Header="Kart" Binding="{Binding CardLabel}" Width="80"/>
                <DataGridTextColumn Header="Limit" Binding="{Binding Limit, StringFormat='₺{0:N2}'}" Width="80"/>
                <DataGridTextColumn Header="Kesim" Binding="{Binding StatementDay}" Width="45"/>
                <DataGridTextColumn Header="Ödeme" Binding="{Binding PaymentDueDay}" Width="45"/>
                <DataGridTextColumn Header="Ana Kart" Binding="{Binding ParentCard.CardLabel}" Width="70"/>
                <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding IsActive}" Width="40"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit panel -->
        <Border Grid.Row="2" BorderBrush="#AAA" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10" Background="#F9F9F9">
            <StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Labels -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Banka Adı" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Kart Etiketi" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Limit" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="Kesim" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="8" Text="S.Ödeme" FontSize="11" Foreground="#555" Margin="0,0,0,4"/>

                    <!-- Row 1: Inputs -->
                    <TextBox x:Name="BankNameBox" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" Padding="5,3" FontSize="12"
                             ToolTip="Banka Adı (örn. İş Bankası)" TextChanged="BankNameBox_TextChanged"/>
                    <TextBox x:Name="CardLabelBox" Grid.Row="1" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,3" FontSize="12"
                             ToolTip="Kart Etiketi (örn. Asıl Kart)"/>
                    <TextBox x:Name="LimitBox" Grid.Row="1" Grid.Column="4" VerticalContentAlignment="Center" Padding="5,3" FontSize="12"
                             ToolTip="Kredi Kartı Limiti" TextChanged="LimitBox_TextChanged"/>
                    <TextBox x:Name="StatementDayBox" Grid.Row="1" Grid.Column="6" VerticalContentAlignment="Center" Padding="5,3" FontSize="12"
                             ToolTip="Hesap Kesim Günü (1-31)"/>
                    <TextBox x:Name="PaymentDueDayBox" Grid.Row="1" Grid.Column="8" VerticalContentAlignment="Center" Padding="5,3" FontSize="12"
                             ToolTip="Son Ödeme Günü (1-31)"/>
                </Grid>

                <!-- Parent Card Selection -->
                <Grid Margin="0,15,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔗 Bağlı Olduğu Ana Kart:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#2980B9" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="ParentCardCombo" Grid.Column="1" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                              Padding="3" FontSize="12" ToolTip="Hangi karta bağlı?"/>
                </Grid>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                    <Button x:Name="AddCardBtn" Content="➕ Ekle" FontSize="12"
                            Padding="12,6" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="AddCard_Click" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="UpdateCardBtn" Content="💾 Güncelle" FontSize="12"
                            Padding="12,6" Background="#2196F3" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="UpdateCard_Click" IsEnabled="False" Margin="0,0,8,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="ToggleActiveBtn" Content="🔄 Aktif/Pasif" FontSize="12"
                            Padding="12,6" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"
                            Click="ToggleActive_Click" IsEnabled="False">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>


        <!-- Bottom buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DeleteCardBtn" Content="🗑️ Sil" Width="80" Padding="5"
                    Margin="0,0,10,0" Background="#F44336" Foreground="White" BorderThickness="0"
                    Click="DeleteCard_Click" IsEnabled="False"/>
            <Button Content="Kapat" Width="80" Padding="5" Click="Close_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
