<Window x:Class="FinTrack.WPF.EditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinTrack.WPF"
        mc:Ignorable="d"
        Title="İşlemi Düzenle" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="İşlemi Güncelle" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Date -->
        <TextBlock Text="Tarih:" Grid.Row="1" VerticalAlignment="Center"/>
        <DatePicker x:Name="DatePicker" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" xmlns:System="clr-namespace:System;assembly=mscorlib"/>

        <!-- Amount -->
        <TextBlock Text="Tutar:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBox x:Name="AmountTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="2" TextChanged="AmountTextBox_TextChanged"/>

        <!-- Category -->
        <TextBlock Text="Kategori:" Grid.Row="3" VerticalAlignment="Center"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"
                  SelectedValuePath="Id">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#F44336"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                            <Setter Property="Fill" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Type}" Value="Income">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSubCategory}" Value="True">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Payment Method -->
        <TextBlock Text="Ödeme Yöntemi:" Grid.Row="4" VerticalAlignment="Center"/>
        <ComboBox x:Name="PaymentMethodCombo" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                  SelectionChanged="PaymentMethod_Changed">
            <!-- Populated in code-behind -->
        </ComboBox>

        <!-- Description -->
        <TextBlock Text="Açıklama:" Grid.Row="5" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="İptal" Width="80" Margin="0,0,10,0" Padding="5" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Güncelle" Width="80" Padding="5" Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
