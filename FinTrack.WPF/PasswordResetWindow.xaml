<Window x:Class="FinTrack.WPF.PasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Şifre Sıfırlama" Height="380" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="WhiteSmoke">
    <Grid Margin="20" Background="White">
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Şifrenizi Sıfırlayın" FontSize="18" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock Text="Lütfen size verilen 16 Haneli Kurtarma Kodunu girin:" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="RecoveryCodeInput" Padding="5" FontSize="14" Height="30" Margin="0,0,0,15"/>
                
                <TextBlock Text="Yeni Şifreniz:" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPasswordInput" Padding="5" FontSize="14" Height="30" Margin="0,0,0,15"/>
                
                <TextBlock Text="Yeni Şifreniz (Tekrar):" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="NewPasswordConfirmInput" Padding="5" FontSize="14" Height="30" Margin="0,0,0,25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="İptal" Width="80" Height="35" FontSize="14" Background="#EEE" Foreground="#333" BorderBrush="#CCC" BorderThickness="1" Click="CancelButton_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="ResetButton" Content="Sıfırla" Width="100" Height="35" FontSize="14" FontWeight="Bold" Background="#007ACC" Foreground="White" BorderThickness="0" Click="ResetButton_Click" IsDefault="True">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
