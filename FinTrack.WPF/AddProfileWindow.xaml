<Window x:Class="FinTrack.WPF.AddProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Profil Oluştur" Width="450" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">
    <Border Margin="20" Background="White" CornerRadius="10" BorderBrush="#E0E0E0" BorderThickness="1">
        <StackPanel Margin="20">
            <TextBlock Text="Profil Bilgileri" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

            <TextBlock Text="Profil İsmi:" Foreground="#666" Margin="0,0,0,5"/>
            <TextBox x:Name="ProfileNameInput" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Mevcut Veritabanı Seç (Opsiyonel):" Foreground="#666" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DbPathInput" Height="30" VerticalContentAlignment="Center" Padding="5" IsReadOnly="True" Background="#F9F9F9"/>
                <Button Grid.Column="1" Content="Gözat..." Width="70" Margin="5,0,0,0" Click="BrowseDb_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="80" Height="30" Margin="0,0,10,0" Click="Cancel_Click" Background="Transparent" BorderBrush="#CCC"/>
                <Button Content="Oluştur" Width="100" Height="30" Click="Create_Click" Background="#007ACC" Foreground="White" FontWeight="Bold" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
