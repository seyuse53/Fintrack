<Window x:Class="FinTrack.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinTrack.WPF"
        mc:Ignorable="d"
        Title="FinTrack Erişim" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="WhiteSmoke">
    <Grid Margin="10" Background="White">
        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="InstructionText" Text="FinTrack'e Giriş Yapın" FontSize="18" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <!-- Profil Seçimi -->
                <TextBlock Text="Profil Seçin:" Foreground="#555" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProfileComboBox" Height="30" VerticalContentAlignment="Center" SelectionChanged="ProfileComboBox_SelectionChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="+" Width="30" Height="30" Margin="5,0,0,0" Click="AddProfile_Click" ToolTip="Yeni Profil Ekle"/>
                        <Button Content="-" Width="30" Height="30" Margin="5,0,0,0" Click="RemoveProfileFromList_Click" ToolTip="Profili Listeden Kaldır (Veri Silinmez)" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="Şifrenizi Girin:" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="PasswordBoxInput" Padding="5" FontSize="16" Height="30" Margin="0,0,0,15"/>
                
                <TextBlock x:Name="ConfirmPasswordLabel" Text="Şifrenizi Tekrar Girin:" Foreground="#555" Margin="0,0,0,5" Visibility="Collapsed"/>
                <PasswordBox x:Name="PasswordBoxConfirm" Padding="5" FontSize="16" Height="30" Margin="0,0,0,20" Visibility="Collapsed"/>
                
                <Button x:Name="ConfirmButton" Content="Giriş" Height="35" FontSize="14" FontWeight="Bold" Background="#007ACC" Foreground="White" BorderThickness="0" Click="ConfirmButton_Click" IsDefault="True" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Grid>
                    <TextBlock HorizontalAlignment="Left">
                        <Hyperlink Click="ForgotPassword_Click" Foreground="#007ACC" TextDecorations="None">Şifremi Unuttum</Hyperlink>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right">
                        <Hyperlink x:Name="DeleteProfileLink" Click="DeleteProfileAuth_Click" Foreground="#E74C3C" TextDecorations="None">Profili Sil</Hyperlink>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Sürüm Bilgisi -->
        <TextBlock x:Name="VersionText" Text="v0.0.0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" Foreground="#999" FontSize="11"/>
    </Grid>
</Window>
