<Window Width="650" Height="600" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.AccountDetailWindow"
        x:DataType="vm:AccountDetailViewModel"
        Title="{Binding AccountTitle}"
        WindowStartupLocation="CenterOwner" CanResize="True" Background="{DynamicResource CardSecondaryBackgroundBrush}">
    
    <Grid Margin="10" RowDefinitions="Auto,Auto,*,Auto">
        
        <TextBlock Grid.Row="0" Text="{Binding AccountTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>
        
        <!-- Current Balance -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{loc:Translate AccountDetail_CurrentBalance}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding CurrentBalanceDisplay}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Transactions List -->
        <ScrollViewer Grid.Row="2" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Transactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountDetailItem">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Date & Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date, StringFormat='dd MMM'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Date, StringFormat='yyyy'}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Description & Category -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CategoryName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <!-- Amount -->
                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{Binding ForegroundColor}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                <!-- Edit / Delete Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding !IsInvestment}">
                                    <Button Content="✏️" ToolTip.Tip="{loc:Translate Global_Edit}" Padding="6,4" Margin="0,0,4,0" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:AccountDetailViewModel)DataContext).EditTransactionCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="🗑️" ToolTip.Tip="{loc:Translate Global_Delete}" Padding="6,4" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:AccountDetailViewModel)DataContext).DeleteTransactionCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
        </ScrollViewer>

        <!-- Close Button -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Global_Close}" Padding="10" Command="{Binding CloseCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
