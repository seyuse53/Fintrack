<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.SellInvestmentWindow"
        x:DataType="vm:SellInvestmentViewModel"
        Title="{loc:Translate SellInvestment_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource CardSecondaryBackgroundBrush}">
    
    <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{loc:Translate SellInvestment_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Spacing="5" Margin="0,0,10,0">
                <TextBlock Text="{Binding AssetInfoText}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                    <TextBlock Text="{Binding AvailableAmountText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding AvgCostInfoText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                </StackPanel>

                <TextBlock Text="{loc:Translate Global_Date}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <CalendarDatePicker Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

                <Grid Margin="0,0,0,10" ColumnDefinitions="*,10,*">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                            <TextBlock Text="{loc:Translate SellInvestment_SellAmount}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="{loc:Translate SellInvestment_SellAll}" FontSize="10" Padding="6,2" Margin="10,0,0,0" Command="{Binding SellAllCommand}"
                                    Background="#F39C12" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" CornerRadius="4"/>
                        </Grid>
                        <TextBox Padding="10" FontSize="14" Text="{Binding AmountText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Translate SellInvestment_UnitPrice}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBox Padding="10" FontSize="14" Text="{Binding UnitPriceText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Translate SellInvestment_Fee}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding FeeText}"/>

                <TextBlock Text="{loc:Translate SellInvestment_Account}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Translate SellInvestment_AccountHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Kar/Zarar Önizlemesi -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,5,0,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid ColumnDefinitions="*,*">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Translate SellInvestment_EstRevenue}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBlock Text="{Binding RevenuePreviewText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{loc:Translate SellInvestment_ProfitLoss}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ProfitPreviewText}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Global_Cancel}" Padding="10" Command="{Binding CancelCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderThickness="0" Margin="0,0,10,0" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Translate SellInvestment_Execute}" Padding="10" Command="{Binding SaveCommand}" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
