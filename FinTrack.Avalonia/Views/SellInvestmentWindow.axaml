<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        x:Class="FinTrack.Avalonia.Views.SellInvestmentWindow"
        x:DataType="vm:SellInvestmentViewModel"
        Title="Yatırım Sat" Height="580" Width="470"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#F4F6F9">
    
    <Grid Margin="20" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="Yatırım Satışı" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Spacing="5" Margin="0,0,10,0">
                <TextBlock Text="{Binding AssetInfoText}" FontSize="14" Foreground="#34495E" FontWeight="SemiBold"/>
                
                <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
                    <TextBlock Text="{Binding AvailableAmountText}" FontSize="12" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding AvgCostInfoText}" FontSize="12" Foreground="#7F8C8D"/>
                </StackPanel>

                <TextBlock Text="İşlem Tarihi" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
                <CalendarDatePicker Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

                <Grid Margin="0,0,0,10" ColumnDefinitions="*,10,*">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Satılacak Miktar" FontSize="12" Foreground="#34495E" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Tümünü Sat" FontSize="10" Padding="6,2" Margin="10,0,0,0" Command="{Binding SellAllCommand}"
                                    Background="#F39C12" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" CornerRadius="4"/>
                        </StackPanel>
                        <TextBox Padding="10" FontSize="14" Text="{Binding AmountText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="Birim Fiyatı (₺)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
                        <TextBox Padding="10" FontSize="14" Text="{Binding UnitPriceText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Aracı Kurum Masrafı / Komisyon (₺)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
                <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding FeeText}"/>

                <TextBlock Text="Satış Gelirinin Aktarılacağı Hesap (İsteğe Bağlı)" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
                <TextBlock Text="Seçilen hesabın bakiyesi otomatik olarak artırılacaktır." FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"/>
                <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Kar/Zarar Önizlemesi -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,5,0,0" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tahmini Gelir:" FontSize="12" Foreground="#7F8C8D"/>
                    <TextBlock Text="{Binding RevenuePreviewText}" FontSize="14" FontWeight="SemiBold" Foreground="#2C3E50"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Kar / Zarar:" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ProfitPreviewText}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="90" Padding="10" Command="{Binding CancelCommand}" Background="#ECF0F1" BorderThickness="0" Margin="0,0,10,0" HorizontalContentAlignment="Center"/>
            <Button Content="Satışı Tamamla" Width="120" Padding="10" Command="{Binding SaveCommand}" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
