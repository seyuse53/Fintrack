<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FinTrack.Avalonia.ViewModels"
             xmlns:controls="using:FinTrack.Avalonia.Controls"
             xmlns:conv="using:FinTrack.Avalonia.Converters"
             xmlns:loc="using:FinTrack.Avalonia.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="FinTrack.Avalonia.Views.BesView"
             x:DataType="vm:BesViewModel">

    <UserControl.Resources>
        <conv:ProfitColorConverter x:Key="ProfitColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="10" RowDefinitions="Auto,*">
        
        <!-- Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Translate Bes_CurrentContracts}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Button Grid.Column="1" Content="{loc:Translate Bes_Manage}" Background="#27AE60" Foreground="White" CornerRadius="6" Padding="10,5" Click="ManageBesButton_Click"/>
            </Grid>
        </Border>

        <!-- Investments List -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <ItemsControl ItemsSource="{Binding BesInvestments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel Spacing="10">
                                <!-- Header Row with Name and Action -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Symbol}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                        <Button Content="{loc:Translate Bes_UpdateContract}" Command="{Binding $parent[UserControl].((vm:BesViewModel)DataContext).UpdateValuesCommand}" CommandParameter="{Binding Id}" Background="#1ABC9C" Foreground="White" FontWeight="SemiBold" CornerRadius="6" Padding="10,5"/>
                                        <Button Content="{loc:Translate Bes_History}" Command="{Binding $parent[UserControl].((vm:BesViewModel)DataContext).ShowDetailsCommand}" CommandParameter="{Binding Id}" Background="#2980B9" Foreground="White" FontWeight="SemiBold" CornerRadius="6" Padding="10,5"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Sözleşme Özeti -->
                                <Border Background="#EEF2F5" CornerRadius="8" Padding="15" Margin="0,5">
                                    <Grid ColumnDefinitions="*,*,*">
                                        <!-- Yürürlük ve Emeklilik -->
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_ContractNo}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="130"/>
                                                <TextBlock Text="{Binding BesContractNo, TargetNullValue={loc:Translate Bes_NotEntered}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_StartDate}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="130"/>
                                                <TextBlock Text="{Binding BesStartDate, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue={loc:Translate Bes_NotEntered}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Emeklilik Süresi -->
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_RetirementDate}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="110"/>
                                                <TextBlock Text="{Binding BesRetirementDate, StringFormat='{}{0:dd.MM.yyyy}', TargetNullValue={loc:Translate Bes_NotEntered}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_TimeUntilRetirement}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="110"/>
                                                <TextBlock Text="{Binding TimeUntilRetirement}" FontSize="12" FontWeight="SemiBold" Foreground="#D35400"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Hakediş Oranı -->
                                        <StackPanel Grid.Column="2" Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_VestingRate}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="130"/>
                                                <TextBlock Text="{Binding VestingPercentage, StringFormat='{}{0:P0}'}" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{loc:Translate Bes_StateContribution}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Width="130"/>
                                                <TextBlock Text="{Binding BesStateContribution, StringFormat='{}{0:C2}'}" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Separator Background="#F0F3F4" Margin="0,0,0,5"/>

                                <!-- Detail Metrics Row -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Cost Basis -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardSecondaryBackgroundBrush}" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_CostBasis}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding BesTotalCostBasis, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Gram Gold -->
                                    <Border Grid.Column="2" Background="#FFF9E6" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_GoldBasis}" FontSize="12" Foreground="#D35400"/>
                                            <TextBlock Text="{Binding BesGramGold, StringFormat='{}{0:N2} Gram'}" FontSize="18" FontWeight="Bold" Foreground="#F39C12" Margin="0,2,0,5"/>
                                            
                                            <TextBlock Text="{loc:Translate Bes_GoldCurrent}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding CurrentTotalGramGold, StringFormat='{}{0:N2} Gr'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                                <TextBlock Text="{Binding GoldProfitLoss, StringFormat='({0:+0.00;-0.00;0} Gr)'}" FontSize="11" VerticalAlignment="Bottom" Foreground="{Binding GoldProfitLoss, Converter={StaticResource ProfitColorConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Current Value -->
                                    <Border Grid.Column="4" Background="{DynamicResource CardSecondaryBackgroundBrush}" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_CurrentValue}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding CurrentValue, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Profit -->
                                    <Border Grid.Column="6" Background="{DynamicResource CardSecondaryBackgroundBrush}" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_Profit}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Profit, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="SemiBold" Foreground="{Binding Profit, Converter={StaticResource ProfitColorConverter}}"/>
                                                <TextBlock Text="{Binding ProfitPercentage, StringFormat='({0:N1}%)'}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2" Foreground="{Binding ProfitPercentage, Converter={StaticResource ProfitColorConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- State Contribution -->
                                    <Border Grid.Column="8" Background="#E8F8F5" CornerRadius="8" Padding="15">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_VestedContribution}" FontSize="12" Foreground="#16A085"/>
                                            <TextBlock Text="{Binding VestedStateContribution, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="SemiBold" Foreground="#1ABC9C" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Footer Row: Trend and Details -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_SystemDuration}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding BesTimeInSystem}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_MonthlyAvg}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding BesMonthlyAverage, StringFormat='{}{0:C2}'}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Translate Bes_FundPrice}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding FormattedCurrentPrice}" FontSize="14" FontWeight="SemiBold" Foreground="#2980B9"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Sparkline -->
                                    <controls:AvaloniaSparklineControl Grid.Column="2" Height="30" Width="150" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Data="{Binding SparklineData}" ShowFill="True" ShowLabels="False" ShowTooltip="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>
