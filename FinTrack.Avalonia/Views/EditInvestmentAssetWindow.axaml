<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        x:Class="FinTrack.Avalonia.Views.EditInvestmentAssetWindow"
        x:DataType="vm:EditInvestmentAssetViewModel"
        Title="Varlık Düzenle" Height="380" Width="400"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#F4F6F9">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Varlık Bilgilerini Düzenle" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
        
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="1" Spacing="5">
            <TextBlock Text="Sembol" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
            <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding Symbol}"/>

            <TextBlock Text="Varlık Adı" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
            <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding Name}"/>

            <TextBlock Text="Kategori" FontSize="12" Foreground="#34495E" FontWeight="SemiBold"/>
            <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="İptal" Width="90" Padding="10" Command="{Binding CancelCommand}" Background="#ECF0F1" BorderThickness="0" Margin="0,0,10,0" HorizontalContentAlignment="Center"/>
            <Button Content="💾 Kaydet" Width="120" Padding="10" Command="{Binding SaveCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="5" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
