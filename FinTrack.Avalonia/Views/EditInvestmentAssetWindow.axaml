<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.EditInvestmentAssetWindow"
        x:DataType="vm:EditInvestmentAssetViewModel"
        Title="{loc:Translate EditInvestment_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource CardSecondaryBackgroundBrush}">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="{loc:Translate EditInvestment_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

        <StackPanel Grid.Row="1" Spacing="5" Margin="0,0,10,0">
            <TextBlock Text="{loc:Translate EditInvestment_Symbol}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding Symbol}"/>

            <TextBlock Text="{loc:Translate EditInvestment_Name}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding Name}"/>

            <TextBlock Text="{loc:Translate EditInvestment_Category}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
            <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Global_Cancel}" Padding="10" Command="{Binding CancelCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderThickness="0" Margin="0,0,10,0" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Translate Global_Save}" Padding="10" Command="{Binding SaveCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="5" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
