<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FinTrack.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="FinTrack.Avalonia.Views.CardsView"
             x:DataType="vm:CardsViewModel">

    <Grid Margin="10" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="KREDİ KARTLARIM" FontSize="16" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Kartları Yönet" Background="Transparent" Foreground="#3498DB" FontWeight="SemiBold"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding CardsList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                            <Grid ColumnDefinitions="2*,2*,Auto">
                                
                                <!-- Card Info -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding BankName}" FontSize="13" Foreground="#7F8C8D" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CardLabel}" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding LinkedCardsText}" FontSize="11" Foreground="#95A5A6" Margin="0,2,0,0" IsVisible="{Binding LinkedCardsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    
                                    <TextBlock Text="{Binding StatementDescription}" FontSize="12" Foreground="#34495E" Margin="0,15,0,5"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ProgressBar Grid.Column="0" Value="{Binding ProgressValue}" Minimum="0" Maximum="100" Height="6" Foreground="{Binding ProgressColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DaysRemainingText}" FontSize="11" Foreground="{Binding ProgressColor}" FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Debt & Limit -->
                                <StackPanel Grid.Column="1" Margin="40,0,0,0" VerticalAlignment="Center">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                                        <TextBlock Grid.Column="0" Text="Güncel Borç:" FontSize="13" Foreground="#7F8C8D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalDebt, StringFormat='{}{0:C2}'}" FontSize="18" FontWeight="Bold" Foreground="#E74C3C"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="Kalan Limit:" FontSize="12" Foreground="#95A5A6"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RemainingLimit, StringFormat='{}{0:C0}'}" FontSize="12" Foreground="#27AE60" FontWeight="SemiBold"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding LimitProgressValue}" Minimum="0" Maximum="100" Height="4" Foreground="#E74C3C" Background="#ECF0F1" Margin="0,5,0,0"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="30,0,0,0">
                                    <Button Content="Borç Öde" Background="#27AE60" Foreground="White" CornerRadius="6" Padding="15,8" IsEnabled="{Binding CanPay}"/>
                                    <Button Content="Detaylar" Background="#F4F6F9" Foreground="#34495E" CornerRadius="6" Padding="15,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
