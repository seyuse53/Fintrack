<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        x:Class="FinTrack.Avalonia.Views.EditTransactionWindow"
        x:DataType="vm:EditTransactionViewModel"
        Title="İşlem Düzenle" Height="400" Width="420"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#F4F6F9">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="İşlem Düzenle" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Date -->
        <TextBlock Text="Tarih:" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <CalendarDatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

        <!-- Amount -->
        <TextBlock Text="Tutar:" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="8" Text="{Binding AmountText}" PlaceholderText="Örn: 150.50"/>

        <!-- Category -->
        <TextBlock Text="Kategori:" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" IsEnabled="{Binding !IsTransfer}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{Binding IndentWidth}"/>
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding TypeColor}"/>
                        <TextBlock Text="{Binding TypeIcon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding FontWeight}" Foreground="{Binding ForegroundColor}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Payment Method -->
        <TextBlock Text="Ödeme Yöntemi:" Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" IsEnabled="{Binding !IsTransfer}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Description -->
        <TextBlock Text="Açıklama:" Grid.Row="6" VerticalAlignment="Top" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#34495E"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Width="90" Margin="0,0,10,0" Padding="10" Command="{Binding CancelCommand}" Background="#ECF0F1" BorderThickness="0" HorizontalContentAlignment="Center"/>
            <Button Content="Güncelle" Width="100" Padding="10" Command="{Binding SaveCommand}" Background="#F39C12" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
