<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.Views"
        xmlns:models="using:FinTrack.Core.Models"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.CategoryEditWindow"
        x:DataType="vm:CategoryEditWindow"
        Title="{loc:Translate CategoryEdit_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource CardSecondaryBackgroundBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Translate CategoryEdit_Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

        <!-- Kategori Adı -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="{loc:Translate CategoryEdit_Name}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
            <TextBox x:Name="CategoryNameTextBox" Padding="8" FontSize="14" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4"/>
        </StackPanel>

        <!-- Üst Kategori -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="{loc:Translate CategoryEdit_Parent}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,5"/>
            <ComboBox x:Name="ParentCategoryComboBox" Padding="8" FontSize="14" CornerRadius="4"
                      ItemsSource="{Binding AvailableParents}" SelectedItem="{Binding SelectedParent}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{Binding FullDisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Butonlar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{loc:Translate Global_GiveUp}" Padding="20,8" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" CornerRadius="4"
                    Click="CancelButton_Click"/>
            <Button Content="{loc:Translate Global_Save}" Padding="25,8" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="4"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
