<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.Views"
        xmlns:models="using:FinTrack.Core.Models"
        x:Class="FinTrack.Avalonia.Views.CategoryEditWindow"
        x:DataType="vm:CategoryEditWindow"
        Title="Kategori Düzenle" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="#F4F7F6">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏷️ Kategori Düzenle" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

        <!-- Kategori Adı -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Kategori Adı" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
            <TextBox x:Name="CategoryNameTextBox" Padding="8" FontSize="14" BorderBrush="#D5DBDB" Background="White" CornerRadius="4"/>
        </StackPanel>

        <!-- Üst Kategori -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Üst Kategori" FontSize="12" Foreground="#7F8C8D" Margin="0,0,0,5"/>
            <ComboBox x:Name="ParentCategoryComboBox" Padding="8" FontSize="14" CornerRadius="4"
                      ItemsSource="{Binding AvailableParents}" SelectedItem="{Binding SelectedParent}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <TextBlock Text="{Binding FullDisplayName}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Butonlar -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Vazgeç" Padding="20,8" 
                    Background="#95A5A6" Foreground="White" BorderThickness="0" CornerRadius="4"
                    Click="CancelButton_Click"/>
            <Button Content="💾 Kaydet" Padding="25,8" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="4"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
