<Window Width="800" Height="600" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.ManageInvestmentsWindow"
        x:DataType="vm:ManageInvestmentsViewModel"
        Title="{loc:Translate ManageInvestments_Title}"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CardSecondaryBackgroundBrush}">

    <Grid Margin="10" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:Translate ManageInvestments_Header}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{loc:Translate ManageInvestments_Desc}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="{loc:Translate ManageInvestments_AddBtn}" Padding="10,5" Command="{Binding AddInvestmentCommand}"
                    Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" CornerRadius="5"/>
        </Grid>

        <!-- Investments Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Assets}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" Background="{DynamicResource CardBackgroundBrush}" RowBackground="{DynamicResource CardBackgroundBrush}"
                  Margin="0,0,0,10" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sembol" Binding="{Binding Symbol}" FontWeight="Bold"/>
                <DataGridTextColumn Header="Varlık Adı" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Miktar" Binding="{Binding TotalAmount, StringFormat=N2}"/>
                <DataGridTextColumn Header="Ortalama Maliyet" Binding="{Binding AverageCost, StringFormat='₺{0:N2}'}"/>

                <DataGridTemplateColumn Header="İşlemler" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{loc:Translate ManageInvestments_History}" Command="{Binding $parent[Window].((vm:ManageInvestmentsViewModel)DataContext).ViewHistoryCommand}" CommandParameter="{Binding Id}"
                                        Padding="8,4" Margin="0,0,5,0" Background="#3498DB" Foreground="White" FontWeight="SemiBold" CornerRadius="4" FontSize="11"/>
                                
                                <Button Content="{loc:Translate ManageInvestments_Edit}" Command="{Binding $parent[Window].((vm:ManageInvestmentsViewModel)DataContext).EditInvestmentCommand}" CommandParameter="{Binding Id}"
                                        Padding="8,4" Margin="0,0,5,0" Background="#8E44AD" Foreground="White" FontWeight="SemiBold" CornerRadius="4" FontSize="11"/>
                                
                                <Button Content="{loc:Translate ManageInvestments_Sell}" Command="{Binding $parent[Window].((vm:ManageInvestmentsViewModel)DataContext).SellInvestmentCommand}" CommandParameter="{Binding Id}"
                                        Padding="8,4" Margin="0,0,5,0" Background="#F39C12" Foreground="White" FontWeight="Bold" CornerRadius="4" FontSize="11"/>
                                
                                <Button Content="{loc:Translate ManageInvestments_Delete}" Command="{Binding $parent[Window].((vm:ManageInvestmentsViewModel)DataContext).DeleteInvestmentCommand}" CommandParameter="{Binding Id}"
                                        Padding="8,4" Background="#E74C3C" Foreground="White" FontWeight="Bold" CornerRadius="4" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Translate Global_Close}" Padding="10" Command="{Binding CloseCommand}" Background="#BDC3C7" Foreground="White" FontWeight="Bold" BorderThickness="0" CornerRadius="4" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
