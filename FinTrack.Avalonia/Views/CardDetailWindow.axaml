<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="600"
        Width="650" Height="600"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#F4F6F9"
        x:Class="FinTrack.Avalonia.Views.CardDetailWindow"
        x:DataType="vm:CardDetailViewModel"
        Title="{Binding CardTitle}"
        Icon="/Assets/app_icon.ico">

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
        
        <TextBlock Grid.Row="0" Text="{Binding CardTitle}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#2C3E50"/>
        
        <!-- Card Limits & Debt -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,*,*">
                <!-- Limit -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Limit" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding LimitDisplay}" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Current Debt -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Güncel Borç" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding CurrentDebtDisplay}" FontSize="28" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Remaining Limit -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Kalan Limit" FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding RemainingLimitDisplay}" FontSize="24" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transactions List -->
        <ScrollViewer Grid.Row="2" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Transactions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CardDetailItem">
                        <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Date & Icon -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date, StringFormat='dd MMM'}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50"/>
                                        <TextBlock Text="{Binding Date, StringFormat='yyyy'}" FontSize="12" Foreground="#95A5A6"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Description & Category -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold" Foreground="#34495E"/>
                                    <TextBlock Text="{Binding CategoryName}" FontSize="12" Foreground="#7F8C8D" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                
                                <!-- Amount -->
                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{Binding ForegroundColor}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                <!-- Edit / Delete Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✏️" ToolTip.Tip="Düzenle" Padding="6,4" Margin="0,0,4,0" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:CardDetailViewModel)DataContext).EditTransactionCommand}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="🗑️" ToolTip.Tip="Sil" Padding="6,4" FontSize="14"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[ItemsControl].((vm:CardDetailViewModel)DataContext).DeleteTransactionCommand}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Kapat" Width="100" Padding="10" Command="{Binding CloseCommand}" Background="#ECF0F1" Foreground="#34495E" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
