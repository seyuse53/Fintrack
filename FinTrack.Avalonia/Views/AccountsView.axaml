<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FinTrack.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="FinTrack.Avalonia.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <Grid Margin="10" RowDefinitions="Auto,*">
        
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="CÜZDAN (NAKİT)" FontSize="16" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,10"/>
            <Border Background="White" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1" Padding="20">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Toplam Nakit Bakiye" FontSize="14" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding CashBalanceDisplay}" FontSize="24" FontWeight="Bold" Foreground="#27AE60"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" Content="Transfer" Background="#F39C12" Foreground="White" CornerRadius="6" Padding="15,8" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Detaylar" Background="#3498DB" Foreground="White" CornerRadius="6" Padding="15,8"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="BANKA HESAPLARIM" FontSize="16" FontWeight="Bold" Foreground="#34495E" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Hesapları Yönet" Background="Transparent" Foreground="#3498DB" FontWeight="SemiBold"/>
            </Grid>

            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding AccountsList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BankName}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding AccountName}" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding IBAN}" FontSize="12" Foreground="#BDC3C7" FontFamily="Consolas"/>
                                    </StackPanel>
                                    
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentBalance, StringFormat='{}{0:C2}'}" 
                                               FontSize="18" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Button Content="Transfer" Background="#F4F6F9" Foreground="#34495E" CornerRadius="4"/>
                                        <Button Content="Detaylar" Background="#F4F6F9" Foreground="#34495E" CornerRadius="4"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Grid>

</UserControl>
