<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.TransferWindow"
        x:DataType="vm:TransferViewModel"
        Title="{loc:Translate Transfer_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource CardSecondaryBackgroundBrush}">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Translate Transfer_Title}" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Source Account -->
        <TextBlock Text="{loc:Translate Transfer_From}" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedSourceAccount}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Icon}"/>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Destination Account -->
        <TextBlock Text="{loc:Translate Transfer_To}" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedDestinationAccount}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Icon}"/>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Amount -->
        <TextBlock Text="{loc:Translate Global_Amount}" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Name="AmountTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8" Text="{Binding AmountText}" PlaceholderText="150,50" LostFocus="AmountTextBox_LostFocus"/>

        <!-- Date -->
        <TextBlock Text="{loc:Translate Global_Date}" Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <CalendarDatePicker Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

        <!-- Description -->
        <TextBlock Text="{loc:Translate Global_Description}" Grid.Row="6" VerticalAlignment="Top" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:Translate Global_Cancel}" Margin="0,0,10,0" Padding="10" Command="{Binding CancelCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderThickness="0" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Translate Transfer_Execute}" Padding="10" Command="{Binding SaveTransferCommand}" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
