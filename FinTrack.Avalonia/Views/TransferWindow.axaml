<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        x:Class="FinTrack.Avalonia.Views.TransferWindow"
        x:DataType="vm:TransferViewModel"
        Title="Para Transferi" Height="420" Width="400"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="#F4F6F9">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Para Transferi" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Source Account -->
        <TextBlock Text="Nereden:" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedSourceAccount}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Icon}"/>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Destination Account -->
        <TextBlock Text="Nereye:" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedDestinationAccount}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Icon}"/>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Amount -->
        <TextBlock Text="Tutar:" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <TextBox Name="AmountTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" Padding="8" Text="{Binding AmountText}" PlaceholderText="Örn: 500.00" LostFocus="AmountTextBox_LostFocus"/>

        <!-- Date -->
        <TextBlock Text="Tarih:" Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#34495E"/>
        <CalendarDatePicker Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

        <!-- Description -->
        <TextBlock Text="Açıklama:" Grid.Row="6" VerticalAlignment="Top" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="#34495E"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Width="90" Margin="0,0,10,0" Padding="10" Command="{Binding CancelCommand}" Background="#ECF0F1" BorderThickness="0" HorizontalContentAlignment="Center"/>
            <Button Content="Transfer Et" Width="100" Padding="10" Command="{Binding SaveTransferCommand}" Background="#3498DB" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
