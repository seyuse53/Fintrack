<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.AddTransactionWindow"
        x:DataType="vm:AddTransactionViewModel"
        Title="{loc:Translate AddTransaction_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource CardSecondaryBackgroundBrush}">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:Translate AddTransaction_Title}" Grid.ColumnSpan="2" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryTextBrush}"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <!-- Date -->
        <TextBlock Text="{loc:Translate Global_Date}" Grid.Row="2" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <CalendarDatePicker Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

        <!-- Amount -->
        <TextBlock Text="{loc:Translate Global_Amount}" Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="8" Text="{Binding AmountText}" PlaceholderText="150,50"/>

        <!-- Category -->
        <TextBlock Text="{loc:Translate Global_Category}" Grid.Row="4" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="{Binding IndentWidth}"/>
                        <Ellipse Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding TypeColor}"/>
                        <TextBlock Text="{Binding TypeIcon}" Margin="0,0,5,0" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding FontWeight}" Foreground="{Binding ForegroundColor}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Payment Method -->
        <TextBlock Text="{loc:Translate AddTransaction_PaymentMethod}" Grid.Row="5" VerticalAlignment="Top" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            
            <!-- Installment Toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsVisible="{Binding IsInstallmentAllowed}">
                <CheckBox Content="{loc:Translate AddTransaction_InstallmentCheck}" VerticalAlignment="Center" Cursor="Hand" IsChecked="{Binding IsInstallment}"/>
                <TextBlock Text="{loc:Translate AddTransaction_InstallmentLabel}" Margin="10,0,5,0" VerticalAlignment="Center" IsVisible="{Binding IsInstallment}"/>
                <ComboBox IsVisible="{Binding IsInstallment}" ItemsSource="{Binding InstallmentOptions}" SelectedItem="{Binding SelectedInstallmentCount}"/>
            </StackPanel>
        </StackPanel>

        <!-- Description -->
        <TextBlock Text="{loc:Translate Global_Description}" Grid.Row="6" VerticalAlignment="Top" Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,10" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Description}"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Global_Cancel}" Margin="0,0,10,0" Padding="10" Command="{Binding CancelCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderThickness="0" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Translate Global_Save}" Padding="10" Command="{Binding SaveCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
