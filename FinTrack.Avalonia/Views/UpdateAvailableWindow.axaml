<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.Views"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.UpdateAvailableWindow"
        x:DataType="vm:UpdateAvailableWindow"
        Title="{loc:Translate UpdateAvailable_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False"
        Background="{DynamicResource CardSecondaryBackgroundBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="{loc:Translate UpdateAvailable_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBlock x:Name="CurrentVersionText" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
            <TextBlock x:Name="NewVersionText" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Release Notes -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="15" 
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,10">
            <ScrollViewer>
                <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*">
            <Button Grid.Column="0" Content="{loc:Translate UpdateAvailable_Later}" HorizontalAlignment="Stretch" Margin="0,0,5,0"
                    Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Click="RemindLaterButton_Click" CornerRadius="6" Padding="10" HorizontalContentAlignment="Center"/>
            
            <Button Grid.Column="1" Content="{loc:Translate UpdateAvailable_OpenBrowser}" HorizontalAlignment="Stretch" Margin="5,0,0,0"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    Click="UpdateNowButton_Click" CornerRadius="6" Padding="10" HorizontalContentAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
