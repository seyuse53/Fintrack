<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.UpdateBesValuesWindow"
        x:DataType="vm:UpdateBesValuesViewModel"
        Title="{loc:Translate UpdateBes_Title}"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource CardSecondaryBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True">

    <Border CornerRadius="12" Background="{DynamicResource CardBackgroundBrush}" Margin="10" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.1" OffsetY="5"/>
        </Border.Effect>

        <Grid RowDefinitions="Auto,*,Auto" MaxWidth="650">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,15">
                <TextBlock Text="{loc:Translate UpdateBes_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding AssetName}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel Spacing="10">
                    <!-- Contract No -->
                    <StackPanel>
                        <TextBlock Text="{loc:Translate UpdateBes_ContractNoLabel}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding BesContractNo}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16" PlaceholderText="Örn: 13481845992"/>
                    </StackPanel>

                    <!-- Birth Date & Retirement Age -->
                    <Grid ColumnDefinitions="*,15,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Translate UpdateBes_BirthDate}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding ParticipantBirthDate}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16" HorizontalAlignment="Stretch"/>
                            <TextBlock Text="{loc:Translate UpdateBes_BirthDateDesc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Translate UpdateBes_RetirementAge}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <NumericUpDown Value="{Binding RetirementAge}" Minimum="40" Maximum="80" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <!-- Dates -->
                    <Grid ColumnDefinitions="*,15,*">
                        <!-- Start Date -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Translate UpdateBes_StartDate}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding BesStartDate}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16" HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Retirement Date -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Translate UpdateBes_RetirementDate}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <DatePicker SelectedDate="{Binding BesRetirementDate}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#E0E0E0" Margin="0,5"/>

                    <!-- Custom Values -->
                    <Grid ColumnDefinitions="*,15,*">
                        <!-- Custom Current Value -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Translate UpdateBes_CurrentValue}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <NumericUpDown Value="{Binding CustomCurrentValue}" FormatString="N2" Increment="1000" Minimum="0"
                                           Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16"/>
                            <TextBlock Text="{loc:Translate UpdateBes_CurrentValueDesc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- Custom State Contribution -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Translate UpdateBes_StateContribution}" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <NumericUpDown Value="{Binding CustomStateContribution}" FormatString="N2" Increment="500" Minimum="0"
                                           Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" FontSize="16"/>
                            <TextBlock Text="{loc:Translate UpdateBes_StateContributionDesc}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" ColumnDefinitions="*,10,*" Margin="0,10,0,0">
                <Button Grid.Column="0" Content="{loc:Translate Global_Cancel}" Command="{Binding CancelCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="{DynamicResource CardSecondaryBackgroundBrush}" Foreground="{DynamicResource SecondaryTextBrush}" CornerRadius="6" Padding="12"/>
                <Button Grid.Column="2" Content="{loc:Translate Global_Save}" Command="{Binding SaveCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" CornerRadius="6" Padding="12"/>
            </Grid>
        </Grid>
    </Border>
</Window>
