<Window SizeToContent="WidthAndHeight" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinTrack.Avalonia.ViewModels"
        xmlns:models="using:FinTrack.Core.Models"
        xmlns:loc="using:FinTrack.Avalonia.Localization"
        x:Class="FinTrack.Avalonia.Views.AddInvestmentWindow"
        x:DataType="vm:AddInvestmentViewModel"
        Title="{loc:Translate AddInvestment_Title}"
        WindowStartupLocation="CenterOwner" CanResize="False" Background="{DynamicResource CardSecondaryBackgroundBrush}">
    
    <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto">

        <TextBlock Grid.Row="0" Text="{loc:Translate AddInvestment_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,10"/>

        <!-- Error Message -->
        <TextBlock Grid.Row="0" Text="{Binding ErrorMessage}" Foreground="Red" IsVisible="{Binding HasError}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel Spacing="5" Margin="0,0,10,0">
                <TextBlock Text="{loc:Translate AddInvestment_Symbol}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <AutoCompleteBox Padding="10" FontSize="14" Margin="0,0,0,10"
                                 Text="{Binding Symbol}"
                                 ItemsSource="{Binding AvailableSymbols}"
                                 SelectedItem="{Binding SelectedSymbolItem}"
                                 ValueMemberBinding="{Binding Symbol, DataType=models:SymbolItem}"
                                 FilterMode="Custom"
                                 ItemFilter="{Binding SymbolFilter}"
                                 PlaceholderText="Sembol arayın... (Örn: THYAO)">
                    <AutoCompleteBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SymbolItem">
                            <TextBlock Text="{Binding DisplayText}"/>
                        </DataTemplate>
                    </AutoCompleteBox.ItemTemplate>
                </AutoCompleteBox>

                <TextBlock Text="{loc:Translate AddInvestment_Name}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding Name}"/>

                <TextBlock Text="{loc:Translate AddInvestment_Category}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>

                <TextBlock Text="{loc:Translate Global_Date}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <CalendarDatePicker Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" SelectedDate="{Binding SelectedDate}"/>

                <Grid Margin="0,0,0,10" ColumnDefinitions="*,10,*">
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="{loc:Translate AddInvestment_Amount}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBox Padding="10" FontSize="14" Text="{Binding AmountText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="5">
                        <TextBlock Text="{loc:Translate AddInvestment_UnitPrice}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                        <TextBox Padding="10" FontSize="14" Text="{Binding UnitPriceText}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Translate AddInvestment_Fee}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBox Padding="10" FontSize="14" Margin="0,0,0,10" Text="{Binding FeeText}"/>

                <TextBlock Text="{loc:Translate AddInvestment_PaymentMethod}" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Translate AddInvestment_PaymentHint}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/>
                <ComboBox Padding="10" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Stretch" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Toplam Maliyet Önizlemesi -->
        <Border Grid.Row="2" Background="#EBF5FB" CornerRadius="8" Padding="15" Margin="0,5,0,0" BorderBrush="#AED6F1" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{loc:Translate AddInvestment_TotalCost}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalCostPreviewText}" FontSize="18" FontWeight="Bold" Foreground="#2980B9" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Global_Cancel}" Padding="10" Command="{Binding CancelCommand}" Background="{DynamicResource CardSecondaryBackgroundBrush}" BorderThickness="0" Margin="0,0,10,0" HorizontalContentAlignment="Center"/>
            <Button Content="{loc:Translate AddInvestment_Execute}" Padding="10" Command="{Binding SaveCommand}" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
